+/* Space for one draw's constant data in a dynamic constant buffer reused across
+ * draws and bound with an offset. Mapping vs_cb and ps_cb with DISCARD for every
+ * primitive made wined3d rename them, a new allocation each time. Returns the
+ * mapped data at the returned offset; the caller unmaps cb_ring. */
+static void *d2d_device_context_map_cb(struct d2d_device_context *context,
+        ID3D11DeviceContext *d3d_context, unsigned int size, unsigned int *offset)
+{
+    struct d2d_upload_ring *ring = &context->cb_ring;
+    D3D11_MAP map_type = D3D11_MAP_WRITE_NO_OVERWRITE;
+    unsigned int pos = (ring->pos + 255) & ~255u;
+    D3D11_MAPPED_SUBRESOURCE map;
+    HRESULT hr;
+
+    size = (size + 255) & ~255u;
+    if (!ring->buffer)
+    {
+        D3D11_BUFFER_DESC desc;
+
+        desc.ByteWidth = 256 * 1024;
+        desc.Usage = D3D11_USAGE_DYNAMIC;
+        desc.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+        desc.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+        desc.MiscFlags = 0;
+        desc.StructureByteStride = 0;
+        if (FAILED(hr = ID3D11Device1_CreateBuffer(context->d3d_device, &desc, NULL, &ring->buffer)))
+        {
+            WARN("Failed to create constant buffer, hr %#lx.\n", hr);
+            return NULL;
+        }
+        ring->size = desc.ByteWidth;
+        pos = 0;
+        map_type = D3D11_MAP_WRITE_DISCARD;
+    }
+    else if (pos + size > ring->size)
+    {
+        pos = 0;
+        map_type = D3D11_MAP_WRITE_DISCARD;
+    }
+
+    if (FAILED(hr = ID3D11DeviceContext_Map(d3d_context, (ID3D11Resource *)ring->buffer, 0, map_type, 0, &map)))
+    {
+        WARN("Failed to map constant buffer, hr %#lx.\n", hr);
+        return NULL;
+    }
+    *offset = pos;
+    ring->pos = pos + size;
+    return (BYTE *)map.pData + pos;
+}

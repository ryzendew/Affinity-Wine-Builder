diff --git a/dlls/winex11.drv/mouse.c b/dlls/winex11.drv/mouse.c
index cb79ed5..f717be7 100644
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -1660,6 +1660,26 @@ BOOL X11DRV_EnterNotify( HWND hwnd, XEvent *xev )
     return TRUE;
 }
 
+/***********************************************************************
+ *           X11DRV_LeaveNotify
+ *
+ * Wine's mouse tracking finds the window under the pointer among its own windows
+ * only, so it cannot tell that another application's window now covers ours, for
+ * instance after Alt-Tab with the pointer still. Tell win32u, so that a tracked
+ * window gets its WM_MOUSELEAVE; WPF closes its tooltips on it.
+ */
+BOOL X11DRV_LeaveNotify( HWND hwnd, XEvent *xev )
+{
+    XCrossingEvent *event = &xev->xcrossing;
+
+    TRACE( "hwnd %p/%lx mode %d detail %d\n", hwnd, event->window, event->mode, event->detail );
+
+    if (event->mode != NotifyNormal || event->detail == NotifyInferior) return FALSE;
+    if (hwnd == NtUserGetAncestor( get_capture_window(), GA_ROOT )) return FALSE;
+    NtUserCallHwndParam( hwnd, 0, NtUserPointerLeftWindow );
+    return TRUE;
+}
+
 #ifdef HAVE_X11_EXTENSIONS_XINPUT2_H
 
 /***********************************************************************

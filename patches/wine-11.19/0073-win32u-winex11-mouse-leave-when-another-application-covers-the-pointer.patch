win32u, winex11: Send WM_MOUSELEAVE when another application's window comes up under the pointer.

Wine's mouse tracking finds the window under the pointer with
window_from_point(), which knows only this process's windows. When another
application's window covers ours while the pointer stays still, as after
Alt-Tab, the tracked window keeps believing the pointer is over it and
never gets WM_MOUSELEAVE. WPF closes mouse tooltips on WM_MOUSELEAVE, so in
Affinity a tool's tooltip stayed up, above the other application, until
its display time ran out.

Let the driver tell win32u that the pointer left: the tracking then treats
it as over no window of ours until the next mouse message for one. winex11
does so on a LeaveNotify, now selected for, and when the X focus moves to
another application: X reports the crossing only once the pointer moves
(Xwayland sent nothing when a window came up under a still pointer).

Checked under a nested KWin: with the pointer on a tool icon and its
tooltip shown, a window brought up over it (kcalc, activated) left the
tooltip on top for about two seconds before, and closed it at once after.
Hovering still shows the tooltip.

diff --git a/dlls/win32u/input.c b/dlls/win32u/input.c
index c24bbab..d4bd41b 100644
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -1784,6 +1784,21 @@ void update_current_mouse_window( HWND hwnd, INT hittest, POINT pos )
     tracking->last_mouse_message_hwnd = hwnd;
     tracking->last_mouse_message_hittest = hittest;
     tracking->last_mouse_message_pos = pos;
+    tracking->pointer_outside = FALSE;
+}
+
+/* The driver saw the pointer leave one of our windows. window_from_point() only knows
+ * this process's windows, so without this a tracked window covered by another
+ * application's window under a pointer that does not move never gets WM_MOUSELEAVE.
+ * The next mouse message for one of our windows clears it. */
+void pointer_left_window( HWND hwnd )
+{
+    struct mouse_tracking_info *tracking = get_mouse_tracking_info();
+
+    TRACE( "hwnd %p, tracking %p flags %#x\n", hwnd, tracking->info.hwndTrack, (int)tracking->info.dwFlags );
+    tracking->pointer_outside = TRUE;
+    if (tracking->info.hwndTrack && (tracking->info.dwFlags & (TME_LEAVE | TME_HOVER)))
+        update_mouse_tracking_info( tracking->info.hwndTrack );
 }
 
 static void check_mouse_leave( HWND hwnd, int hittest, struct mouse_tracking_info *tracking )
@@ -1824,6 +1839,13 @@ static HWND get_mouse_window( HWND hwnd, INT *hittest, POINT *ret_pos, struct mo
     HWND ret;
 
     NtUserGetCursorPos( &pos );
+    if (tracking->pointer_outside)
+    {
+        *hittest = HTNOWHERE;
+        *ret_pos = pos;
+        TRACE( "point %s over another application\n", wine_dbgstr_point(&pos) );
+        return 0;
+    }
     ret = window_from_point( hwnd, pos, hittest, FALSE );
     if (ret && ret == tracking->last_mouse_message_hwnd)
     {

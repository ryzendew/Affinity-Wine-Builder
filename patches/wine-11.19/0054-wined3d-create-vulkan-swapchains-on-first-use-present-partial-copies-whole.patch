+++ b/dlls/wined3d/wined3d_vk.h
@@ -1191,6 +1191,7 @@ struct wined3d_swapchain_vk
     } *vk_semaphores;
     unsigned int current, image_count;
     unsigned int width, height;
+    bool vk_swapchain_failed;
 };
 

wined3d: Create Vulkan swapchains on first use, and present partial copies whole.

Two changes to how the Vulkan renderer presents, both for the way WPF does.

Create the Vulkan swapchain on the first present that goes through it, not
with the wined3d swapchain. Creating it attaches a Vulkan surface to the
window, a client window on top of it under winex11, even if nothing is ever
presented through it. WPF renders layered windows (popups, flyouts) into a
lockable back buffer, reads them back and hands the pixels to
UpdateLayeredWindow(), so the unused surface covered what the window
showed: Affinity's tool flyouts came up as black boxes. Create it with the
present's swap interval, rather than with the default and recreating it on
the first blit. If creation fails, presents go through GDI, as they did when
creation failed at init.

Present partial copies whole when that shows the same picture. WPF presents
only the dirty rectangle, unscaled and in place, from a back buffer at least
as large as the window. wined3d sends every partial present through
swapchain_blit_gdi(): a GPU to CPU copy into the window surface, shown when
that surface is next flushed. When the back buffer covers the client area it
holds the whole frame the window shows, so present the client area through
the swapchain instead.

diff --git a/dlls/wined3d/swapchain.c b/dlls/wined3d/swapchain.c
index 88f7142..3ddd01c 100644
--- a/dlls/wined3d/swapchain.c
+++ b/dlls/wined3d/swapchain.c
@@ -627,6 +627,33 @@ static bool swapchain_present_is_partial_copy(struct wined3d_swapchain *swapchai
     return false;
 }
 
+/* A partial present with a COPY swap effect, unscaled and in place, from a
+ * back buffer at least as large as the window's client area. The back buffer
+ * then holds the whole frame that the window shows: only the presented part
+ * changed since the last present, and the rest is still what is on screen.
+ * Presenting the whole client area shows the same picture, through the
+ * swapchain instead of a GPU to CPU copy into the window surface. WPF
+ * presents this way, from a back buffer that may be larger than the window. */
+static bool swapchain_present_can_expand(struct wined3d_swapchain *swapchain,
+        const RECT *src_rect, const RECT *dst_rect, RECT *full_rect)
+{
+    const struct wined3d_swapchain_desc *desc = &swapchain->state.desc;
+    RECT client_rect;
+
+    if (!desc->windowed || desc->backbuffer_count != 1 || !EqualRect(src_rect, dst_rect))
+        return false;
+    if (!GetClientRect(swapchain->win_handle, &client_rect))
+        return false;
+    if (IsRectEmpty(&client_rect) || client_rect.right > desc->backbuffer_width
+            || client_rect.bottom > desc->backbuffer_height)
+        return false;
+    if (dst_rect->left < 0 || dst_rect->top < 0 || dst_rect->right > client_rect.right || dst_rect->bottom > client_rect.bottom)
+        return false;
+
+    *full_rect = client_rect;
+    return true;
+}
+
 static void swapchain_gl_present(struct wined3d_swapchain *swapchain,
         const RECT *src_rect, const RECT *dst_rect, unsigned int swap_interval, uint32_t flags)
 {
@@ -1280,12 +1307,33 @@ static void swapchain_vk_present(struct wined3d_swapchain *swapchain, const RECT
     struct wined3d_swapchain_vk *swapchain_vk = wined3d_swapchain_vk(swapchain);
     struct wined3d_texture *back_buffer = swapchain->back_buffers[0];
     struct wined3d_context_vk *context_vk;
+    RECT full_rect;
+    bool partial;
     VkResult vr;
     HRESULT hr;
 
     context_vk = wined3d_context_vk(context_acquire(swapchain->device, back_buffer, 0));
 
-    if (!swapchain_vk->vk_swapchain || swapchain_present_is_partial_copy(swapchain, dst_rect))
+    if ((partial = swapchain_present_is_partial_copy(swapchain, dst_rect))
+            && swapchain_present_can_expand(swapchain, src_rect, dst_rect, &full_rect))
+    {
+        src_rect = dst_rect = &full_rect;
+        partial = false;
+    }
+
+    if (!swapchain_vk->vk_swapchain && !swapchain_vk->vk_swapchain_failed
+            && swapchain->win_handle != GetDesktopWindow() && !partial)
+    {
+        /* Create it with this present's mode, not recreate it on the blit. */
+        swapchain->swap_interval = min(swap_interval, 1);
+        if (FAILED(hr = wined3d_swapchain_vk_create_vulkan_swapchain(swapchain_vk)))
+        {
+            WARN("Failed to create a Vulkan swapchain, hr %#lx.\n", hr);
+            swapchain_vk->vk_swapchain_failed = true;
+        }
+    }
+
+    if (!swapchain_vk->vk_swapchain || partial)
     {
         swapchain_blit_gdi(swapchain, &context_vk->c, src_rect, dst_rect);
     }
@@ -1851,12 +1899,12 @@ HRESULT wined3d_swapchain_vk_init(struct wined3d_swapchain_vk *swapchain_vk, str
         return hr;
     }
 
-    if (FAILED(hr = wined3d_swapchain_vk_create_vulkan_swapchain(swapchain_vk)))
-    {
-        WARN("Failed to create a Vulkan swapchain, hr %#lx.\n", hr);
-        return hr;
-    }
-
+    /* The Vulkan swapchain is created by the first present that needs it.
+     * Creating it here attaches a Vulkan surface to the window even when the
+     * application never presents through this swapchain: WPF, for example,
+     * renders layered windows into a lockable back buffer, reads it back and
+     * hands the pixels to UpdateLayeredWindow(). The unused surface can then
+     * cover what the window shows. */
     return WINED3D_OK;
 }
 

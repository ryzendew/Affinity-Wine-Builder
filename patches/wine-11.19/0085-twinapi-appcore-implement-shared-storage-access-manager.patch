+
+/* SharedStorageAccessManager -- static-only runtimeclass.
+ *
+ * Serif.Affinity.Application.ProcessCommandLineArguments references
+ * SharedStorageAccessManager.RedeemTokenForFileAsync for its unrelated
+ * "affinity-open-file:" branch. The CLR resolves every type referenced in a
+ * method body when JITing it, so without WinRT metadata + an activation
+ * factory for this type any call into ProcessCommandLineArguments throws
+ * TypeLoadException -- including the "affinity://" OAuth callback path the
+ * Canva sign-in flow depends on (forwarded over a named pipe to
+ * SingleInstanceThread). Providing this stub lets the method JIT and the
+ * login callback proceed; the open-file branch itself simply fails with
+ * E_NOTIMPL, which Affinity does not need under Wine.
+ */
+
+struct shared_storage_manager_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    ISharedStorageAccessManagerStatics ISharedStorageAccessManagerStatics_iface;
+    LONG ref;
+};
+
+static inline struct shared_storage_manager_statics *impl_from_shared_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct shared_storage_manager_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI shared_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct shared_storage_manager_statics *impl = impl_from_shared_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &impl->IActivationFactory_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_ISharedStorageAccessManagerStatics ))
+    {
+        IInspectable_AddRef( (*out = &impl->ISharedStorageAccessManagerStatics_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI shared_factory_AddRef( IActivationFactory *iface )
+{
+    struct shared_storage_manager_statics *impl = impl_from_shared_IActivationFactory( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI shared_factory_Release( IActivationFactory *iface )
+{
+    struct shared_storage_manager_statics *impl = impl_from_shared_IActivationFactory( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static HRESULT WINAPI shared_factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI shared_factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI shared_factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI shared_factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    FIXME( "iface %p, instance %p stub!\n", iface, instance );
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl shared_factory_vtbl =
+{
+    shared_factory_QueryInterface,
+    shared_factory_AddRef,
+    shared_factory_Release,
+    /* IInspectable methods */
+    shared_factory_GetIids,
+    shared_factory_GetRuntimeClassName,
+    shared_factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    shared_factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( shared_storage_statics, ISharedStorageAccessManagerStatics, struct shared_storage_manager_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI shared_storage_statics_AddFile( ISharedStorageAccessManagerStatics *iface,
+        IStorageFile *file, HSTRING *out_token )
+{
+    FIXME( "iface %p, file %p, out_token %p stub!\n", iface, file, out_token );
+    if (out_token) *out_token = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI shared_storage_statics_RedeemTokenForFileAsync( ISharedStorageAccessManagerStatics *iface,
+        HSTRING token, __FIAsyncOperation_1_Windows__CStorage__CStorageFile **operation )
+{
+    FIXME( "iface %p, token %s, operation %p stub!\n", iface, debugstr_hstring(token), operation );
+    if (operation) *operation = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI shared_storage_statics_RemoveFile( ISharedStorageAccessManagerStatics *iface, HSTRING token )
+{
+    FIXME( "iface %p, token %s stub!\n", iface, debugstr_hstring(token) );
+    return E_NOTIMPL;
+}
+
+static const struct ISharedStorageAccessManagerStaticsVtbl shared_storage_statics_vtbl =
+{
+    shared_storage_statics_QueryInterface,
+    shared_storage_statics_AddRef,
+    shared_storage_statics_Release,
+    /* IInspectable methods */
+    shared_storage_statics_GetIids,
+    shared_storage_statics_GetRuntimeClassName,
+    shared_storage_statics_GetTrustLevel,
+    /* ISharedStorageAccessManagerStatics methods */
+    shared_storage_statics_AddFile,
+    shared_storage_statics_RedeemTokenForFileAsync,
+    shared_storage_statics_RemoveFile,
+};
+
+static struct shared_storage_manager_statics shared_storage_manager_statics =
+{
+    {&shared_factory_vtbl},
+    {&shared_storage_statics_vtbl},
+    1,
+};
+
+IActivationFactory *shared_storage_manager_factory = &shared_storage_manager_statics.IActivationFactory_iface;

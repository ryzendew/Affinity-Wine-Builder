+/* Runs on a thread the PE side creates for it, and does not return. */
+NTSTATUS vk_present_worker(void *arg)
+{
+    if (vk_funcs->p_present_worker) vk_funcs->p_present_worker();
+    return STATUS_SUCCESS;
+}
+

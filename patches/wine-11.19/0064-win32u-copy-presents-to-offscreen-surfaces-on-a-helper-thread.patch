+/* Wait for a present to an offscreen surface to complete, so that copying it shows it. */
+static void swapchain_wait_for_present( struct swapchain *swapchain, UINT64 id )
+{
+    struct vulkan_device *device = swapchain->device;
+    VkResult res = device->p_vkWaitForPresentKHR( device->host.device, swapchain->obj.host.swapchain,
+                                                  id, 100000000 /* 100 ms */ );
+    if (res == VK_TIMEOUT)
+    {
+        WARN( "Timed out waiting for present %s on swapchain %p\n", wine_dbgstr_longlong( id ), swapchain );
+        swapchain->present_wait_timeouts++;
+    }
+    else if (res >= VK_SUCCESS) swapchain->present_wait_timeouts = 0;
+}
+
+/* Presents to offscreen surfaces are copied into their window once they have completed, which can take
+ * most of a frame (Xwayland signals completion on a timer for windows that are not mapped). Waiting on
+ * the presenting thread held it for that long every frame, so the copies are made by a thread that
+ * winevulkan starts and hands over with p_present_worker. Until it runs, presents wait as before. */
+static pthread_mutex_t present_worker_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t present_worker_cond = PTHREAD_COND_INITIALIZER;
+static struct list present_worker_queue = LIST_INIT( present_worker_queue );
+static struct swapchain *present_worker_current;
+static BOOL present_worker_running;
+
+static void win32u_present_worker(void)
+{
+    pthread_mutex_lock( &present_worker_lock );
+    present_worker_running = TRUE;
+    for (;;)
+    {
+        struct swapchain *swapchain;
+        struct list *entry;
+        UINT64 id;
+
+        while (!(entry = list_head( &present_worker_queue )))
+            pthread_cond_wait( &present_worker_cond, &present_worker_lock );
+
+        swapchain = LIST_ENTRY( entry, struct swapchain, worker_entry );
+        list_remove( &swapchain->worker_entry );
+        list_init( &swapchain->worker_entry );
+        id = swapchain->worker_id;
+        present_worker_current = swapchain;
+        pthread_mutex_unlock( &present_worker_lock );
+
+        swapchain_wait_for_present( swapchain, id );
+        client_surface_present( swapchain->surface->client );
+
+        pthread_mutex_lock( &present_worker_lock );
+        present_worker_current = NULL;
+        pthread_cond_broadcast( &present_worker_cond );
+    }
+}
+
+/* Queue the copy of a present, replacing a pending one. Returns FALSE if there is no worker. */
+static BOOL queue_present_copy( struct swapchain *swapchain, UINT64 id )
+{
+    BOOL queued = FALSE;
+
+    pthread_mutex_lock( &present_worker_lock );
+    if (present_worker_running)
+    {
+        swapchain->worker_id = id;
+        if (list_empty( &swapchain->worker_entry ))
+            list_add_tail( &present_worker_queue, &swapchain->worker_entry );
+        pthread_cond_broadcast( &present_worker_cond );
+        queued = TRUE;
+    }
+    pthread_mutex_unlock( &present_worker_lock );
+    return queued;
+}
+
+/* Drop a pending copy, and wait for one in progress, before the swapchain goes away. */
+static void cancel_present_copies( struct swapchain *swapchain )
+{
+    pthread_mutex_lock( &present_worker_lock );
+    list_remove( &swapchain->worker_entry );
+    list_init( &swapchain->worker_entry );
+    while (present_worker_current == swapchain)
+        pthread_cond_wait( &present_worker_cond, &present_worker_lock );
+    pthread_mutex_unlock( &present_worker_lock );
+}
+
 static BOOL swapchain_waits_for_present( struct swapchain *swapchain )
 {
     struct surface *surface = swapchain->surface;
@@ -2093,24 +2183,17 @@ static VkResult win32u_vkQueuePresentKHR( VkQueue client_queue, const VkPresentI
         struct swapchain *swapchain = swapchain_from_handle( client_swapchains[i] );
         VkResult swapchain_res = present_info->pResults ? present_info->pResults[i] : res;

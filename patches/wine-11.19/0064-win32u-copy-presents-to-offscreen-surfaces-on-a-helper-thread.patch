diff --git a/dlls/winevulkan/loader.c b/dlls/winevulkan/loader.c
index 864328e..2c67e18 100644
--- a/dlls/winevulkan/loader.c
+++ b/dlls/winevulkan/loader.c
@@ -343,6 +343,25 @@ static BOOL WINAPI wine_vk_init(INIT_ONCE *once, void *param, void **context)
     return !__wine_init_unix_call() && !UNIX_CALL(init, &params);
 }
 
+static DWORD WINAPI present_worker_proc(void *arg)
+{
+    /* named from the thread itself: naming it from its creator is lost when it has not started yet */
+    SetThreadDescription(GetCurrentThread(), L"wine_vk_present");
+    UNIX_CALL(present_worker, NULL);
+    return 0;
+}
+
+/* win32u copies presents to offscreen surfaces into their windows once they have completed. This thread
+ * waits and copies for it, so that the presenting thread does not. */
+static INIT_ONCE present_worker_once = INIT_ONCE_STATIC_INIT;
+static BOOL WINAPI start_present_worker(INIT_ONCE *once, void *param, void **context)
+{
+    HANDLE thread;
+
+    if ((thread = CreateThread(NULL, 0, present_worker_proc, NULL, 0, NULL))) CloseHandle(thread);
+    return TRUE;
+}
+
 static BOOL  wine_vk_init_once(void)
 {
     static INIT_ONCE init_once = INIT_ONCE_STATIC_INIT;
@@ -651,6 +670,7 @@ VkResult WINAPI vkCreateDevice(VkPhysicalDevice physical_device, const VkDeviceC
         free(device);
         *ret = NULL;
     }
+    else InitOnceExecuteOnce(&present_worker_once, start_present_worker, NULL, NULL);
     return params.result;
 }
 

-                swapchain->present_wait_timeouts++;
-            }
-            else if (wait_res >= VK_SUCCESS) swapchain->present_wait_timeouts = 0;
-        }
+            (id = client_present_ids->pPresentIds[i]) && swapchain_waits_for_present( swapchain ) &&
+            !(deferred = queue_present_copy( swapchain, id )))
+            swapchain_wait_for_present( swapchain, id );
 
-        client_surface_present( surface->client );
+        if (!deferred) client_surface_present( surface->client );
 
         if (swapchain_res < VK_SUCCESS) continue;
         if (!get_surface_rect( surface->hwnd, &client_rect, get_dpi_for_window( surface->hwnd ) ))
@@ -3077,6 +3160,7 @@ static struct vulkan_funcs vulkan_funcs =
     .p_vkMapMemory = win32u_vkMapMemory,
     .p_vkMapMemory2KHR = win32u_vkMapMemory2KHR,

+    }
+    bucket = &d2d_close_cache.buckets[hash % D2D_CLOSE_CACHE_BUCKETS];
+    LIST_FOR_EACH_ENTRY(old, bucket, struct d2d_close_cache_entry, bucket_entry)
+    {
+        /* Another thread stored the same input meanwhile. */
+        if (old->hash == hash && old->key_size == key_size && !memcmp(old->key, key, key_size))
+        {

+/* The in-circle test, first in double precision. The vertices are floats, so
+ * they are exact as doubles, and with Shewchuk's first-stage error bound for
+ * doubles a conclusive result is the exact sign, the same one the adaptive
+ * float test arrives at. That test, with its large stack frame and its
+ * exact stages, is needed only when this one is inconclusive; points spaced
+ * closely along a curve are nearly cocircular, and are often too close for
+ * the float filter but rarely for this one. Not used on i386, where the
+ * triangulation runs with the x87 precision set to 24 bits. */
+static BOOL d2d_cdt_incircle(const struct d2d_cdt *cdt, size_t a, size_t b, size_t c, size_t d)
+{
+#ifndef __i386__
+    static const double eps = 1.0 / (1ull << DBL_MANT_DIG);
+    const double err_bound_a = (10.0 + 96.0 * eps) * eps;
+    double dax, day, dbx, dby, dcx, dcy, daz, dbz, dcz;
+    double dbxdcy, dbydcx, dcxday, dcydax, daxdby, daydbx;
+    const D2D1_POINT_2F *p = cdt->vertices;
+    double permanent, det;
+
+    dax = (double)p[a].x - p[d].x;
+    day = (double)p[a].y - p[d].y;
+    dbx = (double)p[b].x - p[d].x;
+    dby = (double)p[b].y - p[d].y;
+    dcx = (double)p[c].x - p[d].x;
+    dcy = (double)p[c].y - p[d].y;
+
+    daz = dax * dax + day * day;
+    dbz = dbx * dbx + dby * dby;
+    dcz = dcx * dcx + dcy * dcy;
+    dbxdcy = dbx * dcy;
+    dbydcx = dby * dcx;
+    dcxday = dcx * day;
+    dcydax = dcy * dax;
+    daxdby = dax * dby;
+    daydbx = day * dbx;
+
+    det = daz * (dbxdcy - dbydcx) + dbz * (dcxday - dcydax) + dcz * (daxdby - daydbx);
+    permanent = daz * (fabs(dbxdcy) + fabs(dbydcx))
+            + dbz * (fabs(dcxday) + fabs(dcydax))
+            + dcz * (fabs(daxdby) + fabs(daydbx));
+    if (det > err_bound_a * permanent || -det > err_bound_a * permanent)
+        return det > 0.0;
+#endif
+
+    return d2d_cdt_incircle_adapt(cdt, a, b, c, d);
+}

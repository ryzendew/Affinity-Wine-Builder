+}
+
+static BOOL d2d_geometry_close_cache_lookup(struct d2d_geometry *geometry,
+        const unsigned char *key, size_t key_size, UINT64 hash)
+{
+    struct d2d_close_cache_entry *entry;
+    struct list *bucket;
+    BOOL found = FALSE;
+
+    AcquireSRWLockExclusive(&d2d_close_cache.lock);
+    if (d2d_close_cache.initialised)
+    {
+        bucket = &d2d_close_cache.buckets[hash % D2D_CLOSE_CACHE_BUCKETS];
+        LIST_FOR_EACH_ENTRY(entry, bucket, struct d2d_close_cache_entry, bucket_entry)
+        {
+            if (entry->hash != hash || entry->key_size != key_size || memcmp(entry->key, key, key_size))
+                continue;
+            if ((found = d2d_geometry_close_cache_apply(geometry, entry)))
+            {
+                list_remove(&entry->lru_entry);
+                list_add_head(&d2d_close_cache.lru, &entry->lru_entry);
+            }
+            break;
+        }
+    }
+    ReleaseSRWLockExclusive(&d2d_close_cache.lock);
+    return found;
+}

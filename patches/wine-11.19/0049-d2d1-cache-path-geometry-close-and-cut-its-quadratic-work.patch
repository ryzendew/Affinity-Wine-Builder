+/* Close() result cache.
+ *
+ * Close() resolves self-intersections, splits overlapping beziers and
+ * triangulates the fill, all eagerly and all at least quadratic in the
+ * segment count. Applications that rebuild the same geometries for every
+ * frame pay that again each time; text drawn as paths, a thousand small
+ * curved figures per redraw, costs a large part of a second.
+ *
+ * Close() is a function of the fill mode and the figures alone, so its
+ * result is kept, keyed on a full copy of that input. A geometry whose input
+ * matches byte for byte gets an exact copy of the stored figures and fill
+ * data, the same state the computation would have produced. */
+
+#define D2D_CLOSE_CACHE_MIN_VERTICES 8
+#define D2D_CLOSE_CACHE_BUCKETS 1024
+#define D2D_CLOSE_CACHE_MAX_BYTES (24u << 20)
+
+struct d2d_close_cache_figure
+{
+    D2D1_POINT_2F *vertices;
+    enum d2d_vertex_type *vertex_types;
+    size_t vertex_count;
+    D2D1_POINT_2F *bezier_controls;
+    size_t bezier_control_count;
+    D2D1_RECT_F bounds;
+    unsigned int flags;
+};
+
+struct d2d_close_cache_entry
+{
+    struct list lru_entry;
+    struct list bucket_entry;
+    UINT64 hash;
+    size_t bytes;
+
+    unsigned char *key;
+    size_t key_size;
+
+    struct d2d_close_cache_figure *figures;
+    size_t figure_count;
+    D2D1_POINT_2F *fill_vertices;
+    size_t fill_vertex_count;
+    struct d2d_face *faces;
+    size_t face_count;
+    struct d2d_curve_vertex *bezier_vertices;
+    size_t bezier_vertex_count;
+};
+
+static struct
+{
+    SRWLOCK lock;
+    struct list lru;
+    struct list buckets[D2D_CLOSE_CACHE_BUCKETS];
+    BOOL initialised;
+    size_t bytes;
+} d2d_close_cache = {SRWLOCK_INIT, LIST_INIT(d2d_close_cache.lru)};
+
+static void *d2d_memdup(const void *src, size_t size)
+{
+    void *dst;
+
+    if (!size)
+        return NULL;
+    if ((dst = malloc(size)))
+        memcpy(dst, src, size);
+    return dst;
+}
+
+static unsigned char *d2d_close_cache_put(unsigned char *p, const void *data, size_t size)
+{
+    if (size)
+        memcpy(p, data, size);
+    return p + size;
+}
+
+/* The input Close() reads: the fill mode and, per figure, the vertices,
+ * their types, the bezier controls, the bounds and the flags. */
+static unsigned char *d2d_close_cache_make_key(const struct d2d_geometry *geometry, size_t *size)
+{
+    size_t i, total = sizeof(geometry->u.path.fill_mode) + sizeof(geometry->u.path.figure_count);
+    const struct d2d_figure *figure;
+    unsigned char *key, *p;
+
+    for (i = 0; i < geometry->u.path.figure_count; ++i)
+    {
+        figure = &geometry->u.path.figures[i];
+        total += 2 * sizeof(size_t) + sizeof(figure->bounds) + sizeof(figure->flags)
+                + figure->vertex_count * (sizeof(*figure->vertices) + sizeof(*figure->vertex_types))
+                + figure->bezier_control_count * sizeof(*figure->bezier_controls);
+    }
+
+    if (!(key = malloc(total)))
+        return NULL;
+
+    p = d2d_close_cache_put(key, &geometry->u.path.fill_mode, sizeof(geometry->u.path.fill_mode));
+    p = d2d_close_cache_put(p, &geometry->u.path.figure_count, sizeof(geometry->u.path.figure_count));
+    for (i = 0; i < geometry->u.path.figure_count; ++i)
+    {
+        figure = &geometry->u.path.figures[i];
+        p = d2d_close_cache_put(p, &figure->vertex_count, sizeof(size_t));
+        p = d2d_close_cache_put(p, &figure->bezier_control_count, sizeof(size_t));
+        p = d2d_close_cache_put(p, &figure->bounds, sizeof(figure->bounds));
+        p = d2d_close_cache_put(p, &figure->flags, sizeof(figure->flags));
+        p = d2d_close_cache_put(p, figure->vertices, figure->vertex_count * sizeof(*figure->vertices));
+        p = d2d_close_cache_put(p, figure->vertex_types, figure->vertex_count * sizeof(*figure->vertex_types));
+        p = d2d_close_cache_put(p, figure->bezier_controls,
+                figure->bezier_control_count * sizeof(*figure->bezier_controls));
+    }
+
+    *size = total;
+    return key;
+}
+
+static UINT64 d2d_close_cache_hash(const unsigned char *data, size_t size)
+{
+    UINT64 h = 0xcbf29ce484222325ull, w;
+
+    for (; size >= sizeof(w); data += sizeof(w), size -= sizeof(w))
+    {
+        memcpy(&w, data, sizeof(w));
+        h = (h ^ w) * 0x9e3779b97f4a7c15ull;
+        h ^= h >> 29;
+    }
+    while (size--)
+        h = (h ^ *data++) * 0x100000001b3ull;
+    return h;
+}
+
+static void d2d_close_cache_entry_free(struct d2d_close_cache_entry *entry)
+{
+    size_t i;
+
+    for (i = 0; i < entry->figure_count; ++i)
+    {
+        free(entry->figures[i].vertices);
+        free(entry->figures[i].vertex_types);
+        free(entry->figures[i].bezier_controls);
+    }
+    free(entry->figures);
+    free(entry->fill_vertices);
+    free(entry->faces);
+    free(entry->bezier_vertices);
+    free(entry->key);
+    free(entry);
+}
+
+static BOOL d2d_geometry_close_cache_eligible(const struct d2d_geometry *geometry)
+{
+    size_t i, vertex_count = 0;
+
+    /* Close() starts from empty fill data; anything else is not ours to key. */
+    if (geometry->fill.vertex_count || geometry->fill.face_count
+            || geometry->fill.bezier_vertex_count || geometry->fill.arc_vertex_count)
+        return FALSE;
+
+    for (i = 0; i < geometry->u.path.figure_count; ++i)
+        vertex_count += geometry->u.path.figures[i].vertex_count;
+    return vertex_count >= D2D_CLOSE_CACHE_MIN_VERTICES;
+}
+
+/* Hands the geometry copies of a stored result. Called with the lock held. */
+static BOOL d2d_geometry_close_cache_apply(struct d2d_geometry *geometry,
+        const struct d2d_close_cache_entry *entry)
+{
+    struct d2d_close_cache_figure *copies;
+    D2D1_POINT_2F *fill_vertices = NULL;
+    struct d2d_curve_vertex *bezier_vertices = NULL;
+    struct d2d_face *faces = NULL;
+    struct d2d_figure *figure;
+    BOOL ok = TRUE;
+    size_t i;
+
+    if (!(copies = calloc(entry->figure_count, sizeof(*copies))))
+        return FALSE;
+    for (i = 0; i < entry->figure_count && ok; ++i)
+    {
+        const struct d2d_close_cache_figure *src = &entry->figures[i];
+
+        copies[i] = *src;
+        copies[i].vertices = d2d_memdup(src->vertices, src->vertex_count * sizeof(*src->vertices));
+        copies[i].vertex_types = d2d_memdup(src->vertex_types, src->vertex_count * sizeof(*src->vertex_types));
+        copies[i].bezier_controls = d2d_memdup(src->bezier_controls,
+                src->bezier_control_count * sizeof(*src->bezier_controls));
+        ok = (!src->vertex_count || (copies[i].vertices && copies[i].vertex_types))
+                && (!src->bezier_control_count || copies[i].bezier_controls);
+    }
+    if (ok)
+    {
+        fill_vertices = d2d_memdup(entry->fill_vertices, entry->fill_vertex_count * sizeof(*fill_vertices));
+        faces = d2d_memdup(entry->faces, entry->face_count * sizeof(*faces));
+        bezier_vertices = d2d_memdup(entry->bezier_vertices, entry->bezier_vertex_count * sizeof(*bezier_vertices));
+        ok = (!entry->fill_vertex_count || fill_vertices) && (!entry->face_count || faces)
+                && (!entry->bezier_vertex_count || bezier_vertices);
+    }
+    if (!ok)
+    {
+        for (i = 0; i < entry->figure_count; ++i)
+        {
+            free(copies[i].vertices);
+            free(copies[i].vertex_types);
+            free(copies[i].bezier_controls);
+        }
+        free(copies);
+        free(fill_vertices);
+        free(faces);
+        free(bezier_vertices);
+        return FALSE;
+    }
+
+    for (i = 0; i < entry->figure_count; ++i)
+    {
+        figure = &geometry->u.path.figures[i];
+        free(figure->vertices);
+        free(figure->vertex_types);
+        free(figure->bezier_controls);
+        figure->vertices = copies[i].vertices;
+        figure->vertices_size = copies[i].vertex_count;
+        figure->vertex_types = copies[i].vertex_types;
+        figure->vertex_types_size = copies[i].vertex_count;
+        figure->vertex_count = copies[i].vertex_count;
+        figure->bezier_controls = copies[i].bezier_controls;
+        figure->bezier_controls_size = copies[i].bezier_control_count;
+        figure->bezier_control_count = copies[i].bezier_control_count;
+        figure->bounds = copies[i].bounds;
+        figure->flags = copies[i].flags;
+    }
+    free(copies);

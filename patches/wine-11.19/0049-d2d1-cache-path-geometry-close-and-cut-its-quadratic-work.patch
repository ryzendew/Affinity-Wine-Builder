+static size_t d2d_probe_edges_bucket(const struct d2d_probe_edges *pe, float y)
+{
+    float f = (y - pe->top) * pe->scale;
+
+    if (!(f > 0.0f))
+        return 0;
+    if (f >= pe->bucket_count)
+        return pe->bucket_count - 1;
+    return f;
+}
+
+/* The last vertex d2d_path_geometry_point_inside() uses in a figure. */
+static size_t d2d_probe_edges_last(const struct d2d_figure *figure, BOOL triangles_only)
+{
+    size_t last = figure->vertex_count - 1;
+
+    if (!triangles_only)
+    {
+        while (last && figure->vertex_types[last] == D2D_VERTEX_TYPE_NONE)
+            --last;
+    }
+    return last;
+}
+
+/* The polygon edges d2d_path_geometry_point_inside() walks: in each figure,
+ * every vertex it uses joined to the next, and the last to the first. */
+#define D2D_FOR_EACH_PROBE_EDGE(geometry, triangles_only, figure, p0, p1, i, j, last) \
+    for (i = 0; i < (geometry)->u.path.figure_count; ++i) \
+        for (figure = &(geometry)->u.path.figures[i], \
+                last = figure->vertex_count ? d2d_probe_edges_last(figure, triangles_only) : 0, \
+                p0 = figure->vertex_count ? &figure->vertices[last] : NULL, j = 0; \
+                figure->vertex_count && j <= last; ++j) \
+            if ((triangles_only || figure->vertex_types[j] != D2D_VERTEX_TYPE_NONE) \
+                    && (p1 = &figure->vertices[j]))
+
+static void d2d_probe_edge_set(struct d2d_probe_edge *e, const D2D1_POINT_2F *p0, const D2D1_POINT_2F *p1,
+        const D2D1_RECT_F *bounds)
+{
+    e->p0 = *p0;
+    e->p1 = *p1;
+    e->bounds = bounds;
+}
+
+/* Edges are copied; bounds are read through the figure, as they are by
+ * d2d_path_geometry_point_inside(). The structure stays valid while the
+ * figures array is not reallocated and no vertex the walk uses changes:
+ * inserting D2D_VERTEX_TYPE_NONE vertices is fine when "triangles_only" is
+ * not set. */
+static BOOL d2d_probe_edges_init(struct d2d_probe_edges *pe, const struct d2d_geometry *geometry,
+        BOOL triangles_only)
+{
+    float top = FLT_MAX, bottom = -FLT_MAX;
+    const D2D1_POINT_2F *p0, *p1;
+    const struct d2d_figure *figure;
+    size_t i, j, b, last, edge_count = 0;
+    struct d2d_probe_edge *e;
+
+    memset(pe, 0, sizeof(*pe));
+    D2D_FOR_EACH_PROBE_EDGE(geometry, triangles_only, figure, p0, p1, i, j, last)
+    {
+        top = min(top, p1->y);
+        bottom = max(bottom, p1->y);
+        ++edge_count;
+        p0 = p1;
+    }
+    if (!edge_count)
+        return FALSE;
+
+    pe->bucket_count = min(edge_count, 4096);
+    pe->top = top;
+    pe->scale = bottom > top ? pe->bucket_count / (bottom - top) : 0.0f;
+    if (!(pe->starts = calloc(pe->bucket_count + 1, sizeof(*pe->starts))))
+        return FALSE;
+
+    D2D_FOR_EACH_PROBE_EDGE(geometry, triangles_only, figure, p0, p1, i, j, last)
+    {
+        for (b = d2d_probe_edges_bucket(pe, min(p0->y, p1->y)); b <= d2d_probe_edges_bucket(pe, max(p0->y, p1->y)); ++b)
+            ++pe->starts[b + 1];
+        p0 = p1;
+    }
+    for (b = 0; b < pe->bucket_count; ++b)
+        pe->starts[b + 1] += pe->starts[b];
+
+    if (!(pe->edges = malloc(max(pe->starts[pe->bucket_count], 1) * sizeof(*pe->edges))))
+    {
+        free(pe->starts);
+        return FALSE;
+    }
+    D2D_FOR_EACH_PROBE_EDGE(geometry, triangles_only, figure, p0, p1, i, j, last)
+    {
+        for (b = d2d_probe_edges_bucket(pe, min(p0->y, p1->y)); b <= d2d_probe_edges_bucket(pe, max(p0->y, p1->y)); ++b)
+        {
+            e = &pe->edges[pe->starts[b]++];
+            d2d_probe_edge_set(e, p0, p1, &figure->bounds);
+        }
+        p0 = p1;
+    }
+    /* The fill pass advanced each start to the next bucket's start. */
+    memmove(&pe->starts[1], &pe->starts[0], pe->bucket_count * sizeof(*pe->starts));
+    pe->starts[0] = 0;
+
+    return TRUE;
+}
+
+static void d2d_probe_edges_cleanup(struct d2d_probe_edges *pe)
+{
+    free(pe->starts);
+    free(pe->edges);
+}
+
+/* Same as d2d_path_geometry_point_inside() with the "triangles_only" the
+ * edges were collected for. An edge can only count when the probe's y lies
+ * within the edge's y range, and the probe's bucket holds every such edge;
+ * the test and the score are the same, and the score is a sum, so the order
+ * of the edges does not matter. */
+static BOOL d2d_probe_edges_point_inside(const struct d2d_probe_edges *pe,
+        const struct d2d_geometry *geometry, const D2D1_POINT_2F *probe)
+{
+    const struct d2d_probe_edge *e, *end;
+    D2D1_POINT_2F v_p, v_probe;
+    unsigned int score = 0;
+    size_t b;
+
+    b = d2d_probe_edges_bucket(pe, probe->y);
+    for (e = &pe->edges[pe->starts[b]], end = &pe->edges[pe->starts[b + 1]]; e < end; ++e)
+    {
+        if (probe->x < e->bounds->left || probe->x > e->bounds->right
+                || probe->y < e->bounds->top || probe->y > e->bounds->bottom)
+            continue;
+
+        d2d_point_subtract(&v_p, &e->p1, &e->p0);
+        d2d_point_subtract(&v_probe, probe, &e->p0);
+
+        if ((probe->y < e->p0.y) != (probe->y < e->p1.y) && v_probe.x < v_p.x * (v_probe.y / v_p.y))
+        {
+            if (geometry->u.path.fill_mode == D2D1_FILL_MODE_ALTERNATE || (probe->y < e->p0.y))
+                ++score;
+            else
+                --score;
+        }
+    }
+
+    return geometry->u.path.fill_mode == D2D1_FILL_MODE_ALTERNATE ? score & 1 : score;
+}

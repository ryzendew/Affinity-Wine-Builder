+    geometry->fill.vertices = fill_vertices;
+    geometry->fill.vertex_count = entry->fill_vertex_count;
+    geometry->fill.faces = faces;
+    geometry->fill.faces_size = geometry->fill.face_count = entry->face_count;
+    geometry->fill.bezier_vertices = bezier_vertices;
+    geometry->fill.bezier_vertices_size = geometry->fill.bezier_vertex_count = entry->bezier_vertex_count;

+/* Stores the result Close() just computed. Takes ownership of the key. */
+static void d2d_geometry_close_cache_store(const struct d2d_geometry *geometry,
+        unsigned char *key, size_t key_size, UINT64 hash)
+{
+    struct d2d_close_cache_entry *entry, *old;
+    const struct d2d_figure *figure;
+    struct list *bucket, *tail;
+    BOOL ok = TRUE;
+    size_t i;
+
+    if (!(entry = calloc(1, sizeof(*entry))))

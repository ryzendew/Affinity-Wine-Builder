+        struct d2d_close_cache_figure *dst = &entry->figures[i];
+
+        figure = &geometry->u.path.figures[i];
+        dst->vertex_count = figure->vertex_count;
+        dst->bezier_control_count = figure->bezier_control_count;
+        dst->bounds = figure->bounds;
+        dst->flags = figure->flags;
+        dst->vertices = d2d_memdup(figure->vertices, figure->vertex_count * sizeof(*figure->vertices));
+        dst->vertex_types = d2d_memdup(figure->vertex_types, figure->vertex_count * sizeof(*figure->vertex_types));
+        dst->bezier_controls = d2d_memdup(figure->bezier_controls,
+                figure->bezier_control_count * sizeof(*figure->bezier_controls));
+        ok = (!figure->vertex_count || (dst->vertices && dst->vertex_types))
+                && (!figure->bezier_control_count || dst->bezier_controls);
+        entry->bytes += sizeof(*dst) + figure->vertex_count * (sizeof(*figure->vertices) + sizeof(*figure->vertex_types))
+                + figure->bezier_control_count * sizeof(*figure->bezier_controls);
+    }
+    if (ok)
+    {
+        entry->fill_vertex_count = geometry->fill.vertex_count;
+        entry->face_count = geometry->fill.face_count;
+        entry->bezier_vertex_count = geometry->fill.bezier_vertex_count;
+        entry->fill_vertices = d2d_memdup(geometry->fill.vertices,
+                entry->fill_vertex_count * sizeof(*entry->fill_vertices));
+        entry->faces = d2d_memdup(geometry->fill.faces, entry->face_count * sizeof(*entry->faces));
+        entry->bezier_vertices = d2d_memdup(geometry->fill.bezier_vertices,
+                entry->bezier_vertex_count * sizeof(*entry->bezier_vertices));
+        ok = (!entry->fill_vertex_count || entry->fill_vertices) && (!entry->face_count || entry->faces)
+                && (!entry->bezier_vertex_count || entry->bezier_vertices);
+        entry->bytes += entry->fill_vertex_count * sizeof(*entry->fill_vertices)

+    while (d2d_close_cache.bytes > D2D_CLOSE_CACHE_MAX_BYTES && (tail = list_tail(&d2d_close_cache.lru)))
+    {
+        old = LIST_ENTRY(tail, struct d2d_close_cache_entry, lru_entry);

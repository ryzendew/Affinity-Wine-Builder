+++ b/dlls/win32u/window.c
@@ -2514,6 +2514,21 @@ static BOOL apply_window_pos( HWND hwnd, HWND insert_after, UINT swp_flags, stru
     return ret;
 }
 
+/* flush the surface that a window's drawing goes into: its toplevel's */
+void flush_window_surface( HWND hwnd )
+{
+    struct window_surface *surface;
+    WND *win;
+
+    hwnd = NtUserGetAncestor( hwnd, GA_ROOT );
+    if (!(win = get_win_ptr( hwnd )) || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return;
+    if ((surface = win->surface)) window_surface_add_ref( surface );
+    release_win_ptr( win );
+    if (!surface) return;
+    window_surface_flush( surface );
+    window_surface_release( surface );
+}

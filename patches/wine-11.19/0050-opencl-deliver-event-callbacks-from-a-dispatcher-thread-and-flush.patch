+/* Event callbacks. The host calls them on a driver thread, which is not a
+ * Wine thread and cannot run the application's code. So the host callback
+ * only takes a reference to the event and queues it; a PE thread blocked in
+ * wait_event_callback() takes it off the queue and calls the application,
+ * then releases the event. One node per registration, allocated up front so
+ * the host callback never has to allocate. */
+struct event_callback_node
+{
+    struct event_callback_node *next;
+    cl_event event;
+    cl_int status;
+    void (WINAPI *pfn_notify)(cl_event event, cl_int event_command_status, void *user_data);
+    void *user_data;
+};
+
+static pthread_mutex_t fired_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t fired_cond = PTHREAD_COND_INITIALIZER;
+static struct event_callback_node *fired_head, *fired_tail;
+
+static void CL_CALLBACK host_event_callback( cl_event event, cl_int status, void *data )
+{
+    struct event_callback_node *node = data;
+
+    clRetainEvent( event );  /* the application's callback runs after this returns */
+    node->event = event;
+    node->status = status;
+    node->next = NULL;
+
+    pthread_mutex_lock( &fired_mutex );
+    if (fired_tail) fired_tail->next = node;
+    else fired_head = node;
+    fired_tail = node;
+    pthread_cond_signal( &fired_cond );
+    pthread_mutex_unlock( &fired_mutex );
+}
+
 NTSTATUS wrap_clSetEventCallback( void *args )
 {
     struct clSetEventCallback_params *params = args;
-    TRACE("(%p, %i, %p, %p) \n", params->event, params->command_exec_callback_type, params->pfn_notify, params->user_data);
-    FIXME( "not yet implemented\n" );
-    return CL_SUCCESS;
+    struct event_callback_node *node;
+    cl_int ret;
+
+    TRACE("(%p, %i, %p, %p)\n", params->event, params->command_exec_callback_type, params->pfn_notify, params->user_data);
+
+    if (!(node = calloc( 1, sizeof(*node) ))) return CL_OUT_OF_HOST_MEMORY;
+    node->pfn_notify = params->pfn_notify;
+    node->user_data = params->user_data;
+    if ((ret = clSetEventCallback( params->event, params->command_exec_callback_type,
+                                   host_event_callback, node )))
+        free( node );
+    return ret;
+}
+
+NTSTATUS wait_event_callback( void *args )
+{
+    struct wait_event_callback_params *params = args;
+    struct event_callback_node *node;
+
+    pthread_mutex_lock( &fired_mutex );
+    while (!fired_head) pthread_cond_wait( &fired_cond, &fired_mutex );
+    node = fired_head;
+    if (!(fired_head = node->next)) fired_tail = NULL;
+    pthread_mutex_unlock( &fired_mutex );
+
+    params->event = node->event;
+    params->status = node->status;
+    params->pfn_notify = node->pfn_notify;
+    params->user_data = node->user_data;
+    free( node );
+    return STATUS_SUCCESS;
 }
 
 NTSTATUS wrap_clSetMemObjectDestructorCallback( void *args )

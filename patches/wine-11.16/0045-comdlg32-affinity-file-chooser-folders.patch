+static BOOL get_recent_doc_folder_ex(WCHAR *dir, size_t dir_len, FILETIME *mtime, const WCHAR *want_stem)
+{
+    if (get_recent_doc_folder_pass(dir, dir_len, mtime, want_stem, TRUE)) return TRUE;
+    return get_recent_doc_folder_pass(dir, dir_len, mtime, want_stem, FALSE);
+}
+
+static BOOL get_recent_doc_folder(WCHAR *dir, size_t dir_len, FILETIME *mtime)
+{
+    return get_recent_doc_folder_ex(dir, dir_len, mtime, NULL);
+}
+

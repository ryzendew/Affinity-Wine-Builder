+/* Folder of the last file chosen through a portal dialog.
+ * Save As already gets a starting folder from the document path, but Open/Place/
+ * Export pass nothing, so the portal falls back to its own default. Remembering
+ * the last folder makes those dialogs behave like a native chooser. */
+static WCHAR last_portal_dir_w[MAX_PATH];
+static FILETIME last_portal_dir_time;
+
+/* Affinity keeps its Recents list here, newest first, as plain UTF-8 XML:
+ *   %APPDATA%\Affinity\Affinity\3.0\Settings\RecentFiles.xml
+ * Opening a document from the Recents list never goes through a file dialog, so
+ * comdlg32 would otherwise have no idea the working folder changed. Reading the
+ * newest entry lets Place/Export follow the document the user actually opened.
+ * Returns TRUE and fills dir[] with the folder, plus the file's mtime so the
+ * caller can tell whether it is fresher than the last dialog. */
+/* Compare two path components ignoring case and ignoring the extension. */
+static BOOL stem_matches(const WCHAR *a, const WCHAR *b)
+{
+    const WCHAR *da, *db;
+    size_t la, lb;
+    if (!a || !b || !*a || !*b) return FALSE;
+    da = wcsrchr(a, '.'); la = da ? (size_t)(da - a) : lstrlenW(a);
+    db = wcsrchr(b, '.'); lb = db ? (size_t)(db - b) : lstrlenW(b);
+    if (!la || la != lb) return FALSE;
+    return CompareStringW(LOCALE_INVARIANT, NORM_IGNORECASE, a, la, b, lb) == CSTR_EQUAL;
+}
+
+/* If want_stem is non-NULL, return the folder of the newest Recents entry whose
+ * filename stem matches it (i.e. the folder of THAT document, whichever position
+ * it holds in the list). Otherwise return the folder of the newest entry. */
+static BOOL get_recent_doc_folder_pass(WCHAR *dir, size_t dir_len, FILETIME *mtime,
+                                       const WCHAR *want_stem, BOOL open_only)
+{
+    static const WCHAR rel[] = L"\\Affinity\\Affinity\\3.0\\Settings\\RecentFiles.xml";
+    WCHAR path[MAX_PATH];
+    HANDLE f;
+    DWORD size, got;
+    char *buf, *start, *end;
+    WCHAR *wide;
+    int wlen, probes = 0;
+    BOOL ok = FALSE;
+
+    if (FAILED(SHGetFolderPathW(NULL, CSIDL_APPDATA, NULL, 0, path))) return FALSE;
+    if (lstrlenW(path) + ARRAY_SIZE(rel) >= ARRAY_SIZE(path)) return FALSE;
+    lstrcatW(path, rel);
+
+    f = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                    OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (f == INVALID_HANDLE_VALUE) return FALSE;
+
+    if (mtime) GetFileTime(f, NULL, NULL, mtime);
+
+    size = GetFileSize(f, NULL);
+    if (size == INVALID_FILE_SIZE || size > 1024 * 1024) { CloseHandle(f); return FALSE; }
+    if (!(buf = malloc(size + 1))) { CloseHandle(f); return FALSE; }
+    if (!ReadFile(f, buf, size, &got, NULL)) got = 0;
+    CloseHandle(f);
+    buf[got] = 0;
+
+    /* entries are newest-first; take the first match (or simply the first entry) */
+    start = buf;
+    while (!ok && (start = strstr(start, "<Path>")) && (end = strstr(start, "</Path>")))
+    {
+        char saved = *end;
+        start += 6;
+        *end = 0;
+        xml_unescape(start);
+        wlen = MultiByteToWideChar(CP_UTF8, 0, start, -1, NULL, 0);
+        if (wlen > 0 && (wide = malloc(wlen * sizeof(WCHAR))))
+        {
+            WCHAR *slash;
+            MultiByteToWideChar(CP_UTF8, 0, start, -1, wide, wlen);
+            slash = wcsrchr(wide, '\\');
+            if (!slash) slash = wcsrchr(wide, '/');
+            if (slash && slash != wide)
+            {
+                if (!want_stem || stem_matches(slash + 1, want_stem))
+                {
+                    /* pass 1 insists the document is still open; pass 2 accepts any match */
+                    if (!open_only || (probes++ < 16 && doc_is_open(wide)))
+                    {
+                        *slash = 0;
+                        lstrcpynW(dir, wide, dir_len);
+                        ok = dir[0] != 0;
+                    }
+                }
+            }
+            free(wide);
+        }
+        *end = saved;
+        start = end;
+    }
+    free(buf);
+    return ok;
+}

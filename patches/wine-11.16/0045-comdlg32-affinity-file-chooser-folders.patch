+/* Pick the best "recently used" folder: the folder from the last file dialog, or
+ * the folder of the newest Recents entry - whichever happened more recently. */
+static BOOL get_recent_folder(WCHAR *out, size_t out_len)
+{
+    WCHAR mru_dir[MAX_PATH];
+    FILETIME mru_time;
+    BOOL have_mru = get_recent_doc_folder(mru_dir, ARRAY_SIZE(mru_dir), &mru_time);
+
+    if (have_mru && (!last_portal_dir_w[0] ||
+                     CompareFileTime(&mru_time, &last_portal_dir_time) > 0))
+    {
+        lstrcpynW(out, mru_dir, out_len);
+        return TRUE;
+    }
+    if (last_portal_dir_w[0]) { lstrcpynW(out, last_portal_dir_w, out_len); return TRUE; }
+    if (have_mru) { lstrcpynW(out, mru_dir, out_len); return TRUE; }
+    return FALSE;
+}

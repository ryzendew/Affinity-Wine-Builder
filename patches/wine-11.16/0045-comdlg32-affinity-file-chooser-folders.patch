+/* RecentFiles.xml is XML, so paths containing & < > " ' arrive escaped. Passing
+ * "W:\\Souls &amp; Hearts\\..." through unescaped produces a path that fails Unix
+ * conversion; xdg-desktop-portal-kde then silently DROPS a non-absolute
+ * current_folder (QDir::isRelativePath -> "ignoring non absolute path"), so the
+ * dialog quietly opens somewhere else. */
+static void xml_unescape(char *s)
+{
+    char *r = s, *w = s;
+    while (*r) {
+        if (*r == '&') {
+            if (!strncmp(r, "&amp;",  5)) { *w++ = '&';  r += 5; continue; }
+            if (!strncmp(r, "&lt;",   4)) { *w++ = '<';  r += 4; continue; }
+            if (!strncmp(r, "&gt;",   4)) { *w++ = '>';  r += 4; continue; }
+            if (!strncmp(r, "&quot;", 6)) { *w++ = '"';  r += 6; continue; }
+            if (!strncmp(r, "&apos;", 6)) { *w++ = '\''; r += 6; continue; }
+            if (!strncmp(r, "&#39;",  5)) { *w++ = '\''; r += 5; continue; }
+        }
+        *w++ = *r++;
+    }
+    *w = 0;
+}
+
+/* Affinity drops a "<document>~lock~" sidecar next to every OPEN document and
+ * removes it on clean close, so this distinguishes open documents from merely
+ * recent ones. Do NOT order by its mtime - the heartbeat is ~12 minutes and
+ * fires per document at its own offset, so mtime order just repeats open order. */
+static BOOL doc_is_open(const WCHAR *doc_path)
+{
+    WCHAR lock[MAX_PATH];
+    if (!doc_path || lstrlenW(doc_path) + 7 >= ARRAY_SIZE(lock)) return FALSE;
+    lstrcpyW(lock, doc_path);
+    lstrcatW(lock, L"~lock~");
+    return GetFileAttributesW(lock) != INVALID_FILE_ATTRIBUTES;
+}
+
+static void copy_wchar_to_unix_path(char *dst, size_t dst_len, const WCHAR *wstr);
+
+/* Emit a folder only if it survives validation, so a bad candidate falls through
+ * to the next precedence step instead of silently blanking current_folder. */
+static BOOL set_portal_dir(char *dst, size_t dst_len, const WCHAR *dir)
+{
+    DWORD a;
+    if (!dir || !*dir) return FALSE;
+    a = GetFileAttributesW(dir);
+    if (a == INVALID_FILE_ATTRIBUTES || !(a & FILE_ATTRIBUTE_DIRECTORY)) return FALSE;
+    copy_wchar_to_unix_path(dst, dst_len, dir);
+    if (dst[0] != '/') { dst[0] = 0; return FALSE; }   /* KDE drops non-absolute silently */
+    return TRUE;
+}
+
+/* This is a generic Windows DLL; keep the Affinity-specific lookups off every
+ * other Wine application on the machine. */
+static BOOL host_is_affinity(void)
+{
+    static int cached = -1;
+    WCHAR exe[MAX_PATH], *base;
+    if (cached >= 0) return cached;
+    cached = 0;
+    if (GetModuleFileNameW(GetModuleHandleW(NULL), exe, ARRAY_SIZE(exe)))
+    {
+        base = wcsrchr(exe, '\\');
+        base = base ? base + 1 : exe;
+        if (!wcsicmp(base, L"Affinity.exe")   || !wcsicmp(base, L"Affinity.real.exe") ||
+            !wcsicmp(base, L"Photo.exe")      || !wcsicmp(base, L"Designer.exe")      ||
+            !wcsicmp(base, L"Publisher.exe"))
+            cached = 1;
+    }
+    return cached;
+}

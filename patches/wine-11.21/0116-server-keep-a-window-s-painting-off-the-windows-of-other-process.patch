+                return NULL;
+            }
+            offset_region( tmp, offset_x, offset_y );
+            if (!(region = clip_foreign_children( ptr, tmp, region, offset_x + ptr->client_rect.left,
+                                                  offset_y + ptr->client_rect.top, owner ))) break;
+            if (is_region_empty( region )) break;
+            continue;
+        }
         set_region_rect( tmp, &ptr->visible_rect );
         if (ptr->win_region && !intersect_window_region( tmp, ptr ))
         {
@@ -1297,7 +1349,8 @@ static struct region *get_visible_region( struct window *win, unsigned int flags
 
     if (flags & DCX_CLIPCHILDREN)
     {
-        if (!clip_children( win, NULL, region, win->client_rect.left, win->client_rect.top )) goto error;

+            /* a transparent window is not clipped, but windows of another process inside
+             * it are (an embedded WebView2, whose host window is transparent) */
+            if (!owner || list_empty( &ptr->children )) continue;
+            set_region_rect( tmp, &ptr->client_rect );
+            if (ptr->win_region && !intersect_window_region( tmp, ptr ))
+            {

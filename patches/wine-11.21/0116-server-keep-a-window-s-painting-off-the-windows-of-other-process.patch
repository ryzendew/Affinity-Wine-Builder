server: Keep a window's painting off the windows of other processes inside it.

A window of another process draws straight to the X window of its
toplevel, not into the owner's surface, so whatever the owner paints
there only covers it. Affinity's Help panel showed it: the WebView2 page
went blank whenever Affinity redrew its panels (hovering a tab, scrolling
the canvas), and came back only when the page drew itself again.

Leave those windows out of the region a surface flush may cover, and out
of the visible region of the owner's DCs with WS_CLIPCHILDREN. Look for
them inside transparent windows too: a WS_EX_TRANSPARENT window is still
not clipped, but Affinity hosts the WebView2 in one, which hid the page
from both clips.
---
 server/window.c | 113 +++++++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 103 insertions(+), 10 deletions(-)

diff --git a/server/window.c b/server/window.c
index 3cd82b0..13ce77f 100644
--- a/server/window.c
+++ b/server/window.c
@@ -1199,9 +1199,45 @@ static inline void map_win_region_to_screen( struct window *win, struct region *
 }
 
 
+/* clip the descendants of a window that belong to another process than the owner out of the region:
+ * they draw straight to the X window, so whatever the owner draws there only covers them */
+static struct region *clip_foreign_children( struct window *parent, struct region *parent_clip,
+                                             struct region *region, int offset_x, int offset_y,
+                                             struct process *owner )
+{
+    struct window *ptr;
+    struct region *clip = create_empty_region();
+
+    if (!clip) return NULL;
+    LIST_FOR_EACH_ENTRY( ptr, &parent->children, struct window, entry )
+    {
+        if (!(ptr->style & WS_VISIBLE)) continue;
+        if (!(ptr->ex_style & WS_EX_TRANSPARENT) && ptr->thread && ptr->thread->process != owner)
+        {
+            set_region_rect( clip, &ptr->visible_rect );
+            if (ptr->win_region && !intersect_window_region( clip, ptr )) break;
+            offset_region( clip, offset_x, offset_y );
+            if (!intersect_region( clip, clip, parent_clip )) break;
+            if (!subtract_region( region, region, clip )) break;
+            continue;
+        }
+        if (list_empty( &ptr->children )) continue;
+        set_region_rect( clip, &ptr->client_rect );
+        if (ptr->win_region && !intersect_window_region( clip, ptr )) break;
+        offset_region( clip, offset_x, offset_y );
+        if (!intersect_region( clip, clip, parent_clip )) break;
+        if (!clip_foreign_children( ptr, clip, region, offset_x + ptr->client_rect.left,
+                                    offset_y + ptr->client_rect.top, owner ))
+            break;
+    }
+    free_region( clip );
+    return region;
+}
+

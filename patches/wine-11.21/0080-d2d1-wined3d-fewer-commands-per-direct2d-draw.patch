+/* Writes vertex shader constants left by d2d_device_context_update_vs_cb() on their own. */
+static void d2d_device_context_flush_vs_cb(struct d2d_device_context *context)
+{
+    ID3D11DeviceContext *d3d_context;
+    struct d2d_vs_cb *cb_data;
+
+    context->vs_cb_pending = FALSE;
+    ID3D11Device1_GetImmediateContext(context->d3d_device, &d3d_context);
+    if ((cb_data = d2d_device_context_map_cb(context, d3d_context, sizeof(*cb_data), &context->vs_cb_offset)))
+    {
+        *cb_data = context->vs_cb_data;
+        ID3D11DeviceContext_Unmap(d3d_context, (ID3D11Resource *)context->cb_ring.buffer, 0);
+    }
+    ID3D11DeviceContext_Release(d3d_context);
+}

winex11: Drop the window manager's attention mark on owned windows shown inactive.

KWin marks a window that it maps but does not activate as demanding
attention (_NET_WM_STATE_DEMANDS_ATTENTION), unless it is a special type
such as a toolbar. Wine maps a window shown with SWP_NOACTIVATE with
_NET_WM_USER_TIME 0, which is exactly such a window. For an owned window
that is wrong -- it is a panel or palette, shown on purpose without
activation -- and Plasma's task manager shows a transient's attention on
its owner's entry, which then stays highlighted. With 0037 managing
Affinity's sub-tool panel, its taskbar button turned orange whenever the
panel was up.

Remove the mark from owned windows when the window manager sets it,
unless FlashWindowEx asked for it, which is now tracked.

The panel no longer demands attention in KWin, and the taskbar entry shows
its normal state.

diff --git a/dlls/winex11.drv/event.c b/dlls/winex11.drv/event.c
index ff4c006..a1e11d6 100644
--- a/dlls/winex11.drv/event.c
+++ b/dlls/winex11.drv/event.c
@@ -1161,6 +1161,7 @@ static void handle_net_wm_state_notify( HWND hwnd, XPropertyEvent *event )
     if (!(data = get_win_data( hwnd ))) return;
     if (event->state == PropertyNewValue) value = get_window_net_wm_state( event->display, event->window );
     window_net_wm_state_notify( data, event->serial, value );
+    if (event->state == PropertyNewValue) window_check_demands_attention( data, event->display );
     release_win_data( data );
 
     NtUserPostMessage( hwnd, WM_WINE_WINDOW_STATE_CHANGED, 0, 0 );
diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index b3bb8c3..319244a 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -3788,33 +3788,68 @@ failed:
     return -1;
 }
 
+static void request_demands_attention( struct x11drv_win_data *data, BOOL add )
+{
+    XEvent xev;
+
+    xev.type = ClientMessage;
+    xev.xclient.window = data->whole_window;
+    xev.xclient.message_type = x11drv_atom( _NET_WM_STATE );
+    xev.xclient.serial = 0;
+    xev.xclient.display = data->display;
+    xev.xclient.send_event = True;
+    xev.xclient.format = 32;
+    xev.xclient.data.l[0] = add ? _NET_WM_STATE_ADD : _NET_WM_STATE_REMOVE;
+    xev.xclient.data.l[1] = x11drv_atom( _NET_WM_STATE_DEMANDS_ATTENTION );
+    xev.xclient.data.l[2] = 0;
+    xev.xclient.data.l[3] = 1;
+    xev.xclient.data.l[4] = 0;
+
+    XSendEvent( data->display, DefaultRootWindow( data->display ), False,
+                SubstructureNotifyMask, &xev );
+    XFlush( data->display );
+}
+
+/* KWin marks a window that it maps but does not activate as demanding
+ * attention. For an owned window shown without activation -- a panel or
+ * palette -- that is wrong, and the task manager shows it on the owner's
+ * entry, so remove it unless FlashWindowEx asked for it. */
+void window_check_demands_attention( struct x11drv_win_data *data, Display *display )
+{
+    unsigned long i, count, remaining;
+    BOOL demands = FALSE;
+    Atom type, *state;
+    int format;
+
+    if (data->flashing || !data->managed || data->embedded) return;
+    if (!NtUserGetWindowRelative( data->hwnd, GW_OWNER )) return;
+
+    if (!XGetWindowProperty( display, data->whole_window, x11drv_atom(_NET_WM_STATE), 0,
+                             65536/sizeof(CARD32), False, XA_ATOM, &type, &format, &count,
+                             &remaining, (unsigned char **)&state ))
+    {
+        if (type == XA_ATOM && format == 32)
+            for (i = 0; i < count; i++)
+                if (state[i] == x11drv_atom(_NET_WM_STATE_DEMANDS_ATTENTION)) demands = TRUE;
+        XFree( state );
+    }
+
+    if (!demands) return;
+    TRACE( "window %p/%lx, removing _NET_WM_STATE_DEMANDS_ATTENTION set by the window manager\n",
+           data->hwnd, data->whole_window );
+    request_demands_attention( data, FALSE );
+}
+
 void X11DRV_FlashWindowEx( FLASHWINFO *pfinfo )
 {
     struct x11drv_win_data *data = get_win_data( pfinfo->hwnd );
-    XEvent xev;
 
     if (!data)
         return;
 
+    data->flashing = !!pfinfo->dwFlags;
     if (data->pending_state.wm_state != WithdrawnState)
-    {
-        xev.type = ClientMessage;
-        xev.xclient.window = data->whole_window;
-        xev.xclient.message_type = x11drv_atom( _NET_WM_STATE );
-        xev.xclient.serial = 0;
-        xev.xclient.display = data->display;
-        xev.xclient.send_event = True;
-        xev.xclient.format = 32;
-        xev.xclient.data.l[0] = pfinfo->dwFlags ?  _NET_WM_STATE_ADD : _NET_WM_STATE_REMOVE;
-        xev.xclient.data.l[1] = x11drv_atom( _NET_WM_STATE_DEMANDS_ATTENTION );
-        xev.xclient.data.l[2] = 0;
-        xev.xclient.data.l[3] = 1;
-        xev.xclient.data.l[4] = 0;
-
-        XSendEvent( data->display, DefaultRootWindow( data->display ), False,
-                    SubstructureNotifyMask, &xev );
-        XFlush( data->display );
-    }
+        request_demands_attention( data, !!pfinfo->dwFlags );
     release_win_data( data );
 }
 

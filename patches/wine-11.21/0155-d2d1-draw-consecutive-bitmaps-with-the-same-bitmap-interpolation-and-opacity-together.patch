 static ID3D11Buffer *d2d_outline_create_buffer(ID3D11Device1 *device, const void *data, size_t size, UINT bind)
 {
     D3D11_SUBRESOURCE_DATA init = {.pSysMem = data};
@@ -1693,6 +1701,139 @@ static void STDMETHODCALLTYPE d2d_device_context_FillOpacityMask(ID2D1DeviceCont
         d2d_command_list_fill_opacity_mask(context->target.command_list, context, mask, brush, dst_rect, src_rect);

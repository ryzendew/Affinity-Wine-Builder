d2d1: Skip state that is already bound while the draw state stays bound.

Each primitive set the whole pipeline again: about fifteen Direct3D 11
calls, each taking wined3d's lock and checking its arguments, for
state that rarely changes between primitives. While our state stays
bound across draws it holds exactly what the last draw set: the
application may only use the device context after EndDraw or Flush,
which give it its state back. Remember what was bound and skip the
calls that would not change it; forget it whenever the state is
swapped.

The bound objects stay referenced by the state, so a pointer cannot be
reused for another object while it is remembered.

Affinity, dragging a selection over a vector document: about 3% more
frames and 3% less UI-thread time per frame. The d2d1 conformance
tests give the same results.
---
 dlls/d2d1/d2d1_private.h | 14 ++++++
 dlls/d2d1/device.c       | 99 ++++++++++++++++++++++++++++++++--------
 2 files changed, 95 insertions(+), 18 deletions(-)

diff --git a/dlls/d2d1/d2d1_private.h b/dlls/d2d1/d2d1_private.h
index f4a3c56..8cd3136 100644
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -207,6 +207,20 @@ struct d2d_device_context
     struct d2d_vs_cb vs_cb_data;  /* written with the next pixel shader constants, in one map */
     BOOL vs_cb_pending;
     ID3DDeviceContextState *batch_prev_state; /* the application's state, while ours stays bound */
+    struct d2d_bound_state
+    {
+        BOOL valid;
+        ID3D11InputLayout *il;
+        ID3D11Buffer *ib, *vb, *vs_cb, *ps_cb;
+        unsigned int ib_offset, vb_offset, vb_stride, vs_first, ps_first;
+        ID3D11VertexShader *vs;
+        ID3D11PixelShader *ps;
+        D3D11_VIEWPORT vp;
+        D3D11_RECT scissor;
+        ID3D11RasterizerState *rs;
+        ID3D11RenderTargetView *rtv;
+        ID3D11BlendState *bs;
+    } bound; /* what our state has bound, while it stays bound across draws */
     ID3D11Buffer *vs_cb;
     ID3D11PixelShader *ps;
     ID3D11Buffer *ps_cb;
diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index 04055b6..f66ee41 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -158,6 +158,7 @@ static void d2d_device_context_end_batch(struct d2d_device_context *context)
     unsigned int i;
 
     EnterCriticalSection(&d2d_batch_cs);
+    context->bound.valid = FALSE;
     if (context->batch_prev_state)
     {
         ID3D11Device1_GetImmediateContext1(context->d3d_device, &d3d_context);
@@ -232,6 +233,7 @@ static void d2d_device_context_draw(struct d2d_device_context *render_target, en
         unsigned int vb_stride, struct d2d_brush *brush, struct d2d_brush *opacity_brush)
 {
     struct d2d_shape_resources *shape_resources = &render_target->shape_resources[shape_type];
+    struct d2d_bound_state *bound = &render_target->bound;
     ID3DDeviceContextState *prev_state;
     ID3D11Device1 *device = render_target->d3d_device;
     ID3D11DeviceContext1 *context;
@@ -269,16 +271,63 @@ static void d2d_device_context_draw(struct d2d_device_context *render_target, en
         ib_offset = vb_offset = 0;
     }
 
-    ID3D11DeviceContext1_IASetInputLayout(context, shape_resources->il);
-    ID3D11DeviceContext1_IASetPrimitiveTopology(context, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
-    ID3D11DeviceContext1_IASetIndexBuffer(context, ib, DXGI_FORMAT_R16_UINT, ib_offset);
-    offset = vb_offset;
-    ID3D11DeviceContext1_IASetVertexBuffers(context, 0, 1, &vb, &vb_stride, &offset);
-    ID3D11DeviceContext1_VSSetConstantBuffers1(context, 0, 1, &cb, &vs_first, &vs_count);
-    ID3D11DeviceContext1_VSSetShader(context, shape_resources->vs, NULL, 0);
-    ID3D11DeviceContext1_PSSetConstantBuffers1(context, 0, 1, &cb, &ps_first, &ps_count);
-    ID3D11DeviceContext1_PSSetShader(context, render_target->ps, NULL, 0);
-    ID3D11DeviceContext1_RSSetViewports(context, 1, &vp);
+    /* While our state stays bound across draws (see d2d_device_context_begin_draw_state),
+     * it holds exactly what the last draw set: the application may only use the device
+     * context after EndDraw or Flush, which give it its state back. Skip what is already
+     * set; each Direct3D call takes wined3d's lock, and Affinity draws hundreds of
+     * primitives a frame, most with the same state. The bound objects stay referenced
+     * by the state, so a pointer cannot be reused for a different object meanwhile. */
+    if (prev_state)
+        bound->valid = FALSE;
+
+    if (!bound->valid || bound->il != shape_resources->il)
+    {
+        ID3D11DeviceContext1_IASetInputLayout(context, shape_resources->il);
+        bound->il = shape_resources->il;
+    }
+    if (!bound->valid)
+        ID3D11DeviceContext1_IASetPrimitiveTopology(context, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    if (!bound->valid || bound->ib != ib || bound->ib_offset != ib_offset)
+    {
+        ID3D11DeviceContext1_IASetIndexBuffer(context, ib, DXGI_FORMAT_R16_UINT, ib_offset);
+        bound->ib = ib;
+        bound->ib_offset = ib_offset;
+    }
+    if (!bound->valid || bound->vb != vb || bound->vb_offset != vb_offset || bound->vb_stride != vb_stride)
+    {
+        offset = vb_offset;
+        ID3D11DeviceContext1_IASetVertexBuffers(context, 0, 1, &vb, &vb_stride, &offset);
+        bound->vb = vb;
+        bound->vb_offset = vb_offset;
+        bound->vb_stride = vb_stride;
+    }
+    if (!bound->valid || bound->vs_cb != cb || bound->vs_first != vs_first)
+    {
+        ID3D11DeviceContext1_VSSetConstantBuffers1(context, 0, 1, &cb, &vs_first, &vs_count);
+        bound->vs_cb = cb;
+        bound->vs_first = vs_first;
+    }
+    if (!bound->valid || bound->vs != shape_resources->vs)
+    {
+        ID3D11DeviceContext1_VSSetShader(context, shape_resources->vs, NULL, 0);
+        bound->vs = shape_resources->vs;
+    }
+    if (!bound->valid || bound->ps_cb != cb || bound->ps_first != ps_first)
+    {
+        ID3D11DeviceContext1_PSSetConstantBuffers1(context, 0, 1, &cb, &ps_first, &ps_count);
+        bound->ps_cb = cb;
+        bound->ps_first = ps_first;
+    }
+    if (!bound->valid || bound->ps != render_target->ps)
+    {
+        ID3D11DeviceContext1_PSSetShader(context, render_target->ps, NULL, 0);
+        bound->ps = render_target->ps;
+    }
+    if (!bound->valid || memcmp(&bound->vp, &vp, sizeof(vp)))
+    {
+        ID3D11DeviceContext1_RSSetViewports(context, 1, &vp);
+        bound->vp = vp;
+    }
     if (render_target->clip_stack.count)
     {
         const D2D1_RECT_F *clip_rect;
@@ -296,18 +345,28 @@ static void d2d_device_context_draw(struct d2d_device_context *render_target, en
         scissor_rect.right = render_target->pixel_size.width;
         scissor_rect.bottom = render_target->pixel_size.height;
     }
-    ID3D11DeviceContext1_RSSetScissorRects(context, 1, &scissor_rect);
-    ID3D11DeviceContext1_RSSetState(context, render_target->rs);
-    ID3D11DeviceContext1_OMSetRenderTargets(context, 1, &render_target->target.bitmap->rtv, NULL);
-    if (brush)
+    if (!bound->valid || memcmp(&bound->scissor, &scissor_rect, sizeof(scissor_rect)))
     {
-        ID3D11DeviceContext1_OMSetBlendState(context, render_target->bs, NULL, D3D11_DEFAULT_SAMPLE_MASK);
-        d2d_brush_bind_resources(brush, render_target, 0);
+        ID3D11DeviceContext1_RSSetScissorRects(context, 1, &scissor_rect);
+        bound->scissor = scissor_rect;
     }
-    else
+    if (!bound->valid || bound->rs != render_target->rs)
+    {
+        ID3D11DeviceContext1_RSSetState(context, render_target->rs);
+        bound->rs = render_target->rs;
+    }
+    if (!bound->valid || bound->rtv != render_target->target.bitmap->rtv)
     {
-        ID3D11DeviceContext1_OMSetBlendState(context, NULL, NULL, D3D11_DEFAULT_SAMPLE_MASK);
+        ID3D11DeviceContext1_OMSetRenderTargets(context, 1, &render_target->target.bitmap->rtv, NULL);
+        bound->rtv = render_target->target.bitmap->rtv;
     }
+    if (!bound->valid || bound->bs != (brush ? render_target->bs : NULL))
+    {
+        ID3D11DeviceContext1_OMSetBlendState(context, brush ? render_target->bs : NULL, NULL, D3D11_DEFAULT_SAMPLE_MASK);
+        bound->bs = brush ? render_target->bs : NULL;
+    }
+    if (brush)
+        d2d_brush_bind_resources(brush, render_target, 0);
     if (opacity_brush)
         d2d_brush_bind_resources(opacity_brush, render_target, 1);
 
@@ -321,6 +380,10 @@ static void d2d_device_context_draw(struct d2d_device_context *render_target, en
         ID3D11DeviceContext1_SwapDeviceContextState(context, prev_state, NULL);
         ID3DDeviceContextState_Release(prev_state);
     }
+    else
+    {
+        bound->valid = TRUE;
+    }
     ID3D11DeviceContext1_Release(context);
 

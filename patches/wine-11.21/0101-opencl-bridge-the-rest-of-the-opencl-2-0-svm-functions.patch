+cl_int WINAPI clSetKernelArgSVMPointer( cl_kernel kernel, uint32_t arg_index, const void *arg_value )
+{
+    struct clSetKernelArgSVMPointer_params params = { kernel, arg_index, arg_value };
+    TRACE( "(%p, %u, %p)\n", kernel, arg_index, arg_value );
+    return OPENCL_CALL( clSetKernelArgSVMPointer, &params );
+}
+
+cl_int WINAPI clEnqueueSVMMemcpy( cl_command_queue command_queue, uint32_t blocking_copy,
+        void *dst_ptr, const void *src_ptr, size_t size,
+        uint32_t num_events_in_wait_list, const cl_event *event_wait_list, cl_event *event )
+{
+    struct clEnqueueSVMMemcpy_params params = { command_queue, blocking_copy, dst_ptr, src_ptr, size,
+            num_events_in_wait_list, event_wait_list, event };
+    TRACE( "(%p, %u, %p, %p, %Iu, %u, %p, %p)\n", command_queue, blocking_copy, dst_ptr, src_ptr,
+            size, num_events_in_wait_list, event_wait_list, event );
+    return OPENCL_CALL( clEnqueueSVMMemcpy, &params );
+}
+
+cl_int WINAPI clEnqueueSVMMemFill( cl_command_queue command_queue, void *svm_ptr,
+        const void *pattern, size_t pattern_size, size_t size,
+        uint32_t num_events_in_wait_list, const cl_event *event_wait_list, cl_event *event )
+{
+    struct clEnqueueSVMMemFill_params params = { command_queue, svm_ptr, pattern, pattern_size, size,
+            num_events_in_wait_list, event_wait_list, event };
+    TRACE( "(%p, %p, %p, %Iu, %Iu, %u, %p, %p)\n", command_queue, svm_ptr, pattern,
+            pattern_size, size, num_events_in_wait_list, event_wait_list, event );
+    return OPENCL_CALL( clEnqueueSVMMemFill, &params );
+}
+
+cl_int WINAPI clEnqueueSVMMap( cl_command_queue command_queue, uint32_t blocking_map, cl_bitfield flags,
+        void *svm_ptr, size_t size,
+        uint32_t num_events_in_wait_list, const cl_event *event_wait_list, cl_event *event )
+{
+    struct clEnqueueSVMMap_params params = { command_queue, blocking_map, flags, svm_ptr, size,
+            num_events_in_wait_list, event_wait_list, event };
+    TRACE( "(%p, %u, %s, %p, %Iu, %u, %p, %p)\n", command_queue, blocking_map,
+            wine_dbgstr_longlong(flags), svm_ptr, size, num_events_in_wait_list, event_wait_list, event );
+    return OPENCL_CALL( clEnqueueSVMMap, &params );
+}
+
+cl_int WINAPI clEnqueueSVMUnmap( cl_command_queue command_queue, void *svm_ptr,
+        uint32_t num_events_in_wait_list, const cl_event *event_wait_list, cl_event *event )
+{
+    struct clEnqueueSVMUnmap_params params = { command_queue, svm_ptr,
+            num_events_in_wait_list, event_wait_list, event };
+    TRACE( "(%p, %p, %u, %p, %p)\n", command_queue, svm_ptr,
+            num_events_in_wait_list, event_wait_list, event );
+    return OPENCL_CALL( clEnqueueSVMUnmap, &params );
+}
+
+cl_int WINAPI clEnqueueSVMMigrateMem( cl_command_queue command_queue, uint32_t num_svm_pointers,
+        const void **svm_pointers, const size_t *sizes, cl_bitfield flags,
+        uint32_t num_events_in_wait_list, const cl_event *event_wait_list, cl_event *event )
+{
+    struct clEnqueueSVMMigrateMem_params params = { command_queue, num_svm_pointers, svm_pointers, sizes, flags,
+            num_events_in_wait_list, event_wait_list, event };
+    TRACE( "(%p, %u, %p, %p, %s, %u, %p, %p)\n", command_queue, num_svm_pointers, svm_pointers, sizes,
+            wine_dbgstr_longlong(flags), num_events_in_wait_list, event_wait_list, event );
+    return OPENCL_CALL( clEnqueueSVMMigrateMem, &params );
+}

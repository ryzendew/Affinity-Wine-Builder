opencl: Fire memory object destructor callbacks.

The host cannot call a PE function, so the bridge silently dropped
clSetMemObjectDestructorCallback callbacks. Objects created through the
bridge are now tracked with a shadow reference count of the retains and
releases seen here; the release that brings it to zero fires the
callbacks, when the host frees the object. Objects first seen any other
way keep the old never-fire behavior, since firing early would be a
use after free, and an address with history is never adopted, so a
recycled driver handle stays safe.

From the Affinity-Wine-Builder 11.18 set (its 0066), placed before
clBuildProgram here because this set's dispatcher thread replaced
check_completed_callbacks().
---
 dlls/opencl/pe_thunks.c | 161 ++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 157 insertions(+), 4 deletions(-)

diff --git a/dlls/opencl/pe_thunks.c b/dlls/opencl/pe_thunks.c
index aa76602..4f7e733 100644
--- a/dlls/opencl/pe_thunks.c
+++ b/dlls/opencl/pe_thunks.c
@@ -61,6 +61,108 @@ static void check_completed_callbacks(void)
 
 
 
+/* Destructor callbacks for memory objects. The host cannot invoke PE
+ * callbacks, so the bridge used to drop them silently. Track objects
+ * created through this bridge with a shadow reference count: the release
+ * that brings it to zero fires the registered callbacks, exactly when the
+ * host frees the object for the usual create/use/release pattern.
+ * Objects first seen here by other means (shared from elsewhere) keep the
+ * old never-fire behavior rather than risk firing while still alive:
+ * firing early would be a use-after-free, a leak is merely a leak. */
+struct memobj_dtor
+{
+    struct memobj_dtor *next;
+    void (WINAPI *pfn_notify)(cl_mem memobj, void *user_data);
+    void *user_data;
+};
+
+struct memobj_track
+{
+    struct memobj_track *next;
+    cl_mem memobj;
+    LONG refs;
+    BOOL tracked;
+    struct memobj_dtor *dtors;
+};
+
+static struct memobj_track *memobj_list;
+static SRWLOCK memobj_lock = SRWLOCK_INIT;
+
+static struct memobj_track *find_memobj_locked( cl_mem memobj )
+{
+    struct memobj_track *node = memobj_list;
+    while (node && node->memobj != memobj) node = node->next;
+    return node;
+}
+
+/* Record a newly created object. An address with history stays untracked. */
+static void track_memobj( cl_mem memobj )
+{
+    struct memobj_track *node;
+
+    if (!memobj) return;
+    AcquireSRWLockExclusive( &memobj_lock );
+    node = find_memobj_locked( memobj );
+    if (!node)
+    {
+        node = HeapAlloc( GetProcessHeap(), 0, sizeof(*node) );
+        if (node)
+        {
+            node->memobj = memobj;
+            node->refs = 1;
+            node->tracked = TRUE;
+            node->dtors = NULL;
+            node->next = memobj_list;
+            memobj_list = node;
+        }
+    }
+    ReleaseSRWLockExclusive( &memobj_lock );
+}
+
+static void retain_memobj( cl_mem memobj )
+{
+    struct memobj_track *node;
+
+    AcquireSRWLockExclusive( &memobj_lock );
+    node = find_memobj_locked( memobj );
+    if (node && node->tracked) node->refs++;
+    ReleaseSRWLockExclusive( &memobj_lock );
+}
+
+/* Returns the detached destructor list when the object dies, else NULL. */
+static struct memobj_dtor *release_memobj( cl_mem memobj )
+{
+    struct memobj_track **pp = &memobj_list;
+    struct memobj_track *node;
+    struct memobj_dtor *dtors = NULL;
+
+    AcquireSRWLockExclusive( &memobj_lock );
+    node = find_memobj_locked( memobj );
+    if (node && node->tracked && !--node->refs)
+    {
+        while (*pp != node) pp = &(*pp)->next;
+        *pp = node->next;
+        dtors = node->dtors;
+        HeapFree( GetProcessHeap(), 0, node );
+    }
+    else if (!node)
+    {
+        node = HeapAlloc( GetProcessHeap(), 0, sizeof(*node) );
+        if (node)
+        {
+            node->memobj = memobj;
+            node->refs = 0;
+            node->tracked = FALSE;
+            node->dtors = NULL;
+            node->next = memobj_list;
+            memobj_list = node;
+        }
+    }
+    ReleaseSRWLockExclusive( &memobj_lock );
+    return dtors;
+}
+
+
 cl_int WINAPI clBuildProgram( cl_program program, cl_uint num_devices, const cl_device_id* device_list, const char* options, void (WINAPI* pfn_notify)(cl_program program, void* user_data), void* user_data )
 {
     struct clBuildProgram_params params = { program, num_devices, device_list, options, pfn_notify, user_data };
@@ -101,6 +203,7 @@ cl_mem WINAPI clCreateBuffer( cl_context context, cl_mem_flags flags, size_t siz
     /* The driver may recycle a released handle's address, so drop any values
        cached for it by a previous object. */
     info_cache_invalidate( __retval );
+    track_memobj( __retval );
     return __retval;
 }
 

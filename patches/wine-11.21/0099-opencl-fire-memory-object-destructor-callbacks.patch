@@ -759,9 +866,22 @@ cl_int WINAPI clReleaseKernel( cl_kernel kernel )
 cl_int WINAPI clReleaseMemObject( cl_mem memobj )
 {
     struct clReleaseMemObject_params params = { memobj };
+    struct memobj_dtor *dtors;
+    cl_int ret;
     TRACE( "(%p)\n", memobj );

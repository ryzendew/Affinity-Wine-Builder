 dlls/user32/user_main.c    |  4 ++--
 dlls/user32/user_private.h |  4 ++--
 dlls/win32u/clipboard.c    |  3 ++-
 dlls/winex11.drv/event.c   | 33 +++++++++++++++++++++++++++------
 dlls/wow64win/user.c       |  4 ++++
 include/ntuser.h           |  2 ++
 7 files changed, 46 insertions(+), 18 deletions(-)


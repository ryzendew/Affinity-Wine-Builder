@@ -1595,6 +1595,27 @@ static long drop_effect_to_xdnd_action( UINT effect )
 }
 
 
+/* The drop target's grfKeyState. XDND carries no modifiers, but the X server reports them
+ * for the window under the drag: with a Wayland source, Xwayland gives the drag target
+ * the keyboard state. The button is not in the mask during a compositor-driven drag, and
+ * an XDND drag is always a button drag, so it is added while dragging, and left out at the
+ * drop, as native ole32 does once the button is released. */
+static UINT xdnd_key_state( Display *display, BOOL dragging )
+{
+    Window root, child;
+    int root_x, root_y, x, y;
+    unsigned int mask;
+    UINT state = dragging ? MK_LBUTTON : 0;
+
+    if (!XQueryPointer( display, DefaultRootWindow( display ), &root, &child,
+                        &root_x, &root_y, &x, &y, &mask ))
+        return state;
+    if (mask & ShiftMask) state |= MK_SHIFT;
+    if (mask & (1 << 2) /* ControlMask, #undef in x11drv.h */) state |= MK_CONTROL;
+    if (mask & Mod1Mask) state |= 0x20 /* MK_ALT */;
+    return state;
+}
+
 static void handle_xdnd_position_event( HWND hwnd, XClientMessageEvent *event )
 {
     XClientMessageEvent e;
@@ -1628,7 +1649,7 @@ static void handle_xdnd_position_event( HWND hwnd, XClientMessageEvent *event )
     }
     point = root_to_virtual_screen( x, y );
     effect = xdnd_action_to_drop_effect( event->data.l[4] );
-    effect = drag_drop_drag( hwnd, point, effect );
+    effect = drag_drop_drag( hwnd, point, effect, xdnd_key_state( event->display, TRUE ) );
 
     TRACE( "actionRequested(%ld) chosen(0x%x) at x(%d),y(%d)\n",
            event->data.l[4], effect, point.x, point.y );
@@ -1657,7 +1678,7 @@ static void handle_xdnd_drop_event( HWND hwnd, XClientMessageEvent *event )
     UINT effect;
 
     xdnd_target = 0;
-    effect = drag_drop_drop( hwnd );
+    effect = drag_drop_drop( hwnd, xdnd_key_state( event->display, FALSE ) );
 
     /* Tell the target we are finished. */
     memset( &e, 0, sizeof(e) );

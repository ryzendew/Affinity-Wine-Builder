diff --git a/dlls/d2d1/geometry.c b/dlls/d2d1/geometry.c
index 05deb08..a9be6c9 100644
--- a/dlls/d2d1/geometry.c
+++ b/dlls/d2d1/geometry.c
@@ -7829,3 +7829,22 @@ const struct d2d_geometry *d2d_geometry_get_outline(const struct d2d_geometry *g
         d2d_geometry_ensure_outline((struct d2d_geometry *)geometry);
     return geometry;
 }
+
+/* The stroke outline of a single open line segment, as d2d_geometry_add_figure_outline()
+ * builds it for a path geometry holding only that segment. */
+void d2d_line_outline(struct d2d_outline_vertex *v, struct d2d_face *f,
+        const D2D1_POINT_2F *p0, const D2D1_POINT_2F *p1)
+{
+    D2D1_POINT_2F q;
+
+    d2d_point_subtract(&q, p1, p0);
+    d2d_point_normalise(&q);
+
+    d2d_outline_vertex_set(&v[0], p0->x, p0->y,  q.x,  q.y,  q.x,  q.y);
+    d2d_outline_vertex_set(&v[1], p0->x, p0->y, -q.x, -q.y, -q.x, -q.y);
+    d2d_outline_vertex_set(&v[2], p1->x, p1->y,  q.x,  q.y,  q.x,  q.y);
+    d2d_outline_vertex_set(&v[3], p1->x, p1->y, -q.x, -q.y, -q.x, -q.y);
+
+    d2d_face_set(&f[0], 0, 1, 2);
+    d2d_face_set(&f[1], 2, 1, 3);
+}

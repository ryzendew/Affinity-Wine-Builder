+    BOOL vs_cb_uploaded, ps_cb_uploaded;
+    struct d2d_ps_cb ps_cb_last;
     ID3DDeviceContextState *batch_prev_state; /* the application's state, while ours stays bound */
     struct d2d_bound_state

+
     if (FAILED(hr = ID3D11DeviceContext_Map(d3d_context, (ID3D11Resource *)ring->buffer, 0, map_type, 0, &map)))
     {
         WARN("Failed to map constant buffer, hr %#lx.\n", hr);
@@ -1135,6 +1139,7 @@ static void d2d_device_context_flush_vs_cb(struct d2d_device_context *context)
     {
         *cb_data = context->vs_cb_data;
         ID3D11DeviceContext_Unmap(d3d_context, (ID3D11Resource *)context->cb_ring.buffer, 0);
+        context->vs_cb_uploaded = TRUE;
     }
     ID3D11DeviceContext_Release(d3d_context);
 }

     ID3D11DeviceContext_Unmap(d3d_context, (ID3D11Resource *)context->cb_ring.buffer, 0);
     ID3D11DeviceContext_Release(d3d_context);
@@ -1190,7 +1209,7 @@ static HRESULT d2d_device_context_update_ps_cb(struct d2d_device_context *contex
 static HRESULT d2d_device_context_update_vs_cb(struct d2d_device_context *context,
         const D2D_MATRIX_3X2_F *geometry_transform, float stroke_width)

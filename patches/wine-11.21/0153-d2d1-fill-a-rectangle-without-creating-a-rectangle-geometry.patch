From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jfacemyer <1776340+jfacemyer@users.noreply.github.com>
Date: Tue, 3 Nov 2026 12:53:07 -0500
Subject: [PATCH 153/155] d2d1: Fill a rectangle without creating a rectangle
 geometry.

DrawBitmap() draws through FillRectangle(), once for every bitmap, and
Affinity draws one bitmap per node of the path being edited: tens of
thousands a frame on a dense path. Each created a rectangle geometry,
with its stroke outline, on the heap, and freed it after the draw; that
cost more than the draw itself. Build the fill's four vertices and two
faces on the stack instead.
---
 dlls/d2d1/d2d1_private.h |  2 ++
 dlls/d2d1/device.c       | 19 +++++++++++++------
 dlls/d2d1/geometry.c     | 30 ++++++++++++++++++++++++++++++
 3 files changed, 45 insertions(+), 6 deletions(-)

diff --git a/dlls/d2d1/d2d1_private.h b/dlls/d2d1/d2d1_private.h
index d943940..1a6ef62 100644
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -712,6 +712,8 @@ struct d2d_geometry
 HRESULT d2d_ellipse_geometry_init(struct d2d_geometry *geometry,
         ID2D1Factory *factory, const D2D1_ELLIPSE *ellipse);
 void d2d_path_geometry_init(struct d2d_geometry *geometry, ID2D1Factory *factory);
+void d2d_rectangle_geometry_init_fill(struct d2d_geometry *geometry, const D2D1_RECT_F *rect,
+        D2D1_POINT_2F *vertices, struct d2d_face *faces);
 HRESULT d2d_rectangle_geometry_init(struct d2d_geometry *geometry,
         ID2D1Factory *factory, const D2D1_RECT_F *rect);
 HRESULT d2d_rounded_rectangle_geometry_init(struct d2d_geometry *geometry,
diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index b928945..276ca93 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -1105,12 +1105,16 @@ static void STDMETHODCALLTYPE d2d_device_context_DrawRectangle(ID2D1DeviceContex
     ID2D1RectangleGeometry_Release(geometry);
 }
 
+static void d2d_device_context_fill_geometry(struct d2d_device_context *render_target,
+        const struct d2d_geometry *geometry, struct d2d_brush *brush, struct d2d_brush *opacity_brush);
+
 static void STDMETHODCALLTYPE d2d_device_context_FillRectangle(ID2D1DeviceContext6 *iface,
         const D2D1_RECT_F *rect, ID2D1Brush *brush)
 {
     struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
-    ID2D1RectangleGeometry *geometry;
-    HRESULT hr;
+    struct d2d_geometry geometry;
+    D2D1_POINT_2F vertices[4];
+    struct d2d_face faces[2];
 
     TRACE("iface %p, rect %s, brush %p.\n", iface, debug_d2d_rect_f(rect), brush);
 
@@ -1123,14 +1127,17 @@ static void STDMETHODCALLTYPE d2d_device_context_FillRectangle(ID2D1DeviceContex
         return;
     }
 
-    if (FAILED(hr = ID2D1Factory_CreateRectangleGeometry(context->factory, rect, &geometry)))
+    if (context->target.type == D2D_TARGET_UNKNOWN)
     {
-        ERR("Failed to create geometry, hr %#lx.\n", hr);
+        d2d_device_context_set_error(context, D2DERR_WRONG_STATE);
         return;
     }
 
-    ID2D1DeviceContext6_FillGeometry(iface, (ID2D1Geometry *)geometry, brush, NULL);
-    ID2D1RectangleGeometry_Release(geometry);
+    /* DrawBitmap() comes through here, once for every bitmap: Affinity draws
+     * one per path node. A rectangle geometry object, with the stroke outline
+     * it builds, cost more than the draw. */
+    d2d_rectangle_geometry_init_fill(&geometry, rect, vertices, faces);
+    d2d_device_context_fill_geometry(context, &geometry, unsafe_impl_from_ID2D1Brush(brush), NULL);
 }
 
 static void STDMETHODCALLTYPE d2d_device_context_DrawRoundedRectangle(ID2D1DeviceContext6 *iface,
diff --git a/dlls/d2d1/geometry.c b/dlls/d2d1/geometry.c
index 92507e6..d79cabe 100644
--- a/dlls/d2d1/geometry.c
+++ b/dlls/d2d1/geometry.c
@@ -8045,6 +8045,36 @@ static const struct d2d_geometry_ops d2d_rectangle_geometry_ops =
     .stream = d2d_rectangle_geometry_stream,
 };
 
+/* Just the fill of a rectangle geometry, in caller-provided arrays, for
+ * drawing it once without the object or its stroke outline. */
+void d2d_rectangle_geometry_init_fill(struct d2d_geometry *geometry, const D2D1_RECT_F *rect,
+        D2D1_POINT_2F *vertices, struct d2d_face *faces)
+{
+    float l, r, t, b;
+
+    memset(geometry, 0, sizeof(*geometry));
+    geometry->ID2D1Geometry_iface.lpVtbl = (ID2D1GeometryVtbl *)&d2d_rectangle_geometry_vtbl;
+    geometry->transform = identity;
+    geometry->u.rectangle.rect = *rect;
+
+    l = min(rect->left, rect->right);
+    r = max(rect->left, rect->right);
+    t = min(rect->top, rect->bottom);
+    b = max(rect->top, rect->bottom);
+
+    d2d_point_set(&vertices[0], l, t);
+    d2d_point_set(&vertices[1], l, b);
+    d2d_point_set(&vertices[2], r, b);
+    d2d_point_set(&vertices[3], r, t);
+    geometry->fill.vertices = vertices;
+    geometry->fill.vertex_count = 4;
+
+    d2d_face_set(&faces[0], 1, 2, 0);
+    d2d_face_set(&faces[1], 0, 2, 3);
+    geometry->fill.faces = faces;
+    geometry->fill.face_count = 2;
+}
+
 HRESULT d2d_rectangle_geometry_init(struct d2d_geometry *geometry, ID2D1Factory *factory, const D2D1_RECT_F *rect)
 {
     struct d2d_face *f;

+/* Direct2D draws with its own device context state, and swapped it in and the
+ * application's back out around every primitive: two full state switches per
+ * draw, a large part of the cost of drawing for an application that draws
+ * hundreds of primitives per frame. Keep our state bound across draws instead,
+ * and give the application its state back where it can use the device context
+ * again: at EndDraw, Flush and SetTarget, when the context goes away, and
+ * before another device context draws on the same Direct3D device. Native
+ * Direct2D only submits its batched drawing at those points too.
+ *
+ * Setting WINE_D2D_NO_STATE_BATCHING=1 restores the old behaviour. */
+static CRITICAL_SECTION d2d_batch_cs;
+static CRITICAL_SECTION_DEBUG d2d_batch_cs_debug =
+{
+    0, 0, &d2d_batch_cs,
+    {&d2d_batch_cs_debug.ProcessLocksList, &d2d_batch_cs_debug.ProcessLocksList},
+    0, 0, {(DWORD_PTR)(__FILE__ ": d2d_batch_cs")}
+};
+static CRITICAL_SECTION d2d_batch_cs = {&d2d_batch_cs_debug, -1, 0, 0, 0, 0};
+
+static struct
+{
+    ID3D11Device1 *device;
+    struct d2d_device_context *context;
+} d2d_batch_owners[16];
+
+static BOOL d2d_state_batching(void)
+{
+    static int enabled = -1;
+    char buf[8];
+
+    if (enabled < 0)
+        enabled = !(GetEnvironmentVariableA("WINE_D2D_NO_STATE_BATCHING", buf, sizeof(buf)) && atoi(buf));
+    return enabled;
+}
+
+/* Restore the application's state if this context still has ours bound. */
+static void d2d_device_context_end_batch(struct d2d_device_context *context)
+{
+    ID3D11DeviceContext1 *d3d_context;
+    unsigned int i;
+
+    EnterCriticalSection(&d2d_batch_cs);
+    if (context->batch_prev_state)
+    {
+        ID3D11Device1_GetImmediateContext1(context->d3d_device, &d3d_context);
+        ID3D11DeviceContext1_SwapDeviceContextState(d3d_context, context->batch_prev_state, NULL);
+        ID3DDeviceContextState_Release(context->batch_prev_state);
+        context->batch_prev_state = NULL;
+        ID3D11DeviceContext1_Release(d3d_context);
+    }
+    for (i = 0; i < ARRAY_SIZE(d2d_batch_owners); ++i)
+    {
+        if (d2d_batch_owners[i].context == context)
+            d2d_batch_owners[i].device = NULL, d2d_batch_owners[i].context = NULL;
+    }
+    LeaveCriticalSection(&d2d_batch_cs);
+}
+
+/* Bind our state for a draw. Returns the state to restore right after the draw,
+ * or NULL when it stays bound until the batch ends. */
+static ID3DDeviceContextState *d2d_device_context_begin_draw_state(struct d2d_device_context *context,
+        ID3D11DeviceContext1 *d3d_context)
+{
+    struct d2d_device_context *owner = NULL;
+    ID3DDeviceContextState *prev_state;
+    unsigned int i, slot = ~0u;
+
+    if (!d2d_state_batching())
+    {
+        ID3D11DeviceContext1_SwapDeviceContextState(d3d_context, context->d3d_state, &prev_state);
+        return prev_state;
+    }
+
+    EnterCriticalSection(&d2d_batch_cs);
+    if (context->batch_prev_state)
+    {
+        LeaveCriticalSection(&d2d_batch_cs);
+        return NULL;
+    }
+    for (i = 0; i < ARRAY_SIZE(d2d_batch_owners); ++i)
+    {
+        if (d2d_batch_owners[i].device == context->d3d_device)
+        {
+            owner = d2d_batch_owners[i].context;
+            slot = i;
+            break;
+        }
+        if (!d2d_batch_owners[i].device && slot == ~0u)
+            slot = i;
+    }
+    /* Another context on this device has its state bound: give the application
+     * its state back first, so that ours does not get saved as the
+     * application's. */
+    if (owner)
+        d2d_device_context_end_batch(owner);
+    if (slot == ~0u)
+    {
+        /* Too many devices; do not batch this draw. */
+        LeaveCriticalSection(&d2d_batch_cs);
+        ID3D11DeviceContext1_SwapDeviceContextState(d3d_context, context->d3d_state, &prev_state);
+        return prev_state;
+    }
+    ID3D11DeviceContext1_SwapDeviceContextState(d3d_context, context->d3d_state, &context->batch_prev_state);
+    d2d_batch_owners[slot].device = context->d3d_device;
+    d2d_batch_owners[slot].context = context;
+    LeaveCriticalSection(&d2d_batch_cs);
+    return NULL;
+}

wined3d: Recreate a Vulkan swapchain whose surface was lost, and retry a failed creation.

A present that failed with VK_ERROR_SURFACE_LOST_KHR was only reported,
and every later present to that window failed the same way: the window's
Vulkan surface had been destroyed under us. Affinity's Help panel showed
it: the WebView2 host window is moved into a new floating panel each time
Help opens, and from the second opening the page stayed blank while the
log filled with "Failed to blit image, vr VK_ERROR_SURFACE_LOST_KHR"
(274 times in one session).

Recreate the swapchain, and with it the surface, as for an out-of-date
one. The recreation can fail while the window is being moved, and a
failed creation used to be final for the swapchain; try again at most
every 250 ms instead, presenting through GDI meanwhile.
---
 dlls/wined3d/swapchain.c  | 24 +++++++++++++++++++-----
 dlls/wined3d/wined3d_vk.h |  2 +-
 2 files changed, 20 insertions(+), 6 deletions(-)

diff --git a/dlls/wined3d/swapchain.c b/dlls/wined3d/swapchain.c
index e02c94b..df46a43 100644
--- a/dlls/wined3d/swapchain.c
+++ b/dlls/wined3d/swapchain.c
@@ -1396,15 +1396,22 @@ static void swapchain_vk_present(struct wined3d_swapchain *swapchain, const RECT
         partial = false;
     }
 
-    if (!swapchain_vk->vk_swapchain && !swapchain_vk->vk_swapchain_failed
-            && swapchain->win_handle != GetDesktopWindow() && !partial)
+    /* After a failure, try again now and then rather than never: a window
+     * whose surface was lost (a WebView2 host window shown a second time)
+     * cannot present until it has been recreated, and then can again. */
+    if (!swapchain_vk->vk_swapchain && swapchain->win_handle != GetDesktopWindow() && !partial
+            && (!swapchain_vk->vk_swapchain_failed || GetTickCount() - swapchain_vk->vk_swapchain_failed >= 250))
     {
         /* Create it with this present's mode, not recreate it on the blit. */
         swapchain->swap_interval = min(swap_interval, 1);
         if (FAILED(hr = wined3d_swapchain_vk_create_vulkan_swapchain(swapchain_vk)))
         {
             WARN("Failed to create a Vulkan swapchain, hr %#lx.\n", hr);
-            swapchain_vk->vk_swapchain_failed = true;
+            swapchain_vk->vk_swapchain_failed = GetTickCount() | 1;
+        }
+        else
+        {
+            swapchain_vk->vk_swapchain_failed = 0;
         }
     }
 
@@ -1418,10 +1425,17 @@ static void swapchain_vk_present(struct wined3d_swapchain *swapchain, const RECT
 
         if ((vr = wined3d_swapchain_vk_blit(swapchain_vk, context_vk, src_rect, dst_rect, swap_interval)))
         {
-            if (vr == VK_ERROR_OUT_OF_DATE_KHR || vr == VK_SUBOPTIMAL_KHR)
+            /* A lost surface is not recovered by presenting again: the
+             * window's surface was destroyed under us (a WebView2 host window
+             * shown a second time), and every later present failed with it. */
+            if (vr == VK_ERROR_OUT_OF_DATE_KHR || vr == VK_SUBOPTIMAL_KHR || vr == VK_ERROR_SURFACE_LOST_KHR)
             {
                 if (FAILED(hr = wined3d_swapchain_vk_recreate(swapchain_vk)))
-                    ERR("Failed to recreate swapchain, hr %#lx.\n", hr);
+                {
+                    /* Retried by a later present; until then, presents use GDI. */
+                    WARN("Failed to recreate swapchain, hr %#lx.\n", hr);
+                    swapchain_vk->vk_swapchain_failed = GetTickCount() | 1;
+                }
                 /* Present the frame again on the new swapchain; a suboptimal
                  * frame dropped during a resize stays until the next repaint.
                  * A second VK_SUBOPTIMAL_KHR still presented the frame (the
diff --git a/dlls/wined3d/wined3d_vk.h b/dlls/wined3d/wined3d_vk.h
index 70fb9f9..4a8b625 100644
--- a/dlls/wined3d/wined3d_vk.h
+++ b/dlls/wined3d/wined3d_vk.h
@@ -1192,7 +1192,7 @@ struct wined3d_swapchain_vk
     } *vk_semaphores;
     unsigned int current, image_count;
     unsigned int width, height;
-    bool vk_swapchain_failed;
+    DWORD vk_swapchain_failed; /* tick of the last failed creation, 0 when none */
 };
 
 static inline struct wined3d_swapchain_vk *wined3d_swapchain_vk(struct wined3d_swapchain *swapchain)

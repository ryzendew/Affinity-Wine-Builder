         /* Handle result */
         TRACE("portal open result: status=0x%08lx count=%u first_char=%04x grouped=%u\n",
@@ -3076,7 +3158,10 @@ static HRESULT try_portal_itemdlg(FileDialogImpl *This, HWND hwndOwner)
     else

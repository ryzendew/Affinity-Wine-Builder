@@ -2915,6 +2942,57 @@ static enum portal_policy get_portal_policy(void)
     return PORTAL_POLICY_AUTO;
 }
 
+/* The XDG portal needs "x11:<XID>" for its parent_window argument, so the file
+ * chooser can be kept above the window it is modal for. Wine exposes the X
+ * drawable behind a HWND through the graphics driver escape.
+ *
+ * The struct is laid out explicitly rather than reusing winex11's definition:
+ * that header is private to the driver, and its Drawable is an 8-byte unix
+ * unsigned long, which a PE build would size at 4. */
+/* The portal uses this as the dialog's window title. An application that sets
+ * one gets its own; the rest fall back to the portal's generic caption, which
+ * leaves the dialog unidentifiable -- to the user with several open, and to
+ * anything matching on it, such as a window-manager rule pinning it above its
+ * parent. Name the application rather than hardcoding one, so this is useful for
+ * every app and not just the one it was written for. */
+static void default_portal_title( char *buf, size_t len, BOOL saving )
+{
+    WCHAR path[MAX_PATH], title[MAX_PATH], *name, *dot;
+
+    if (!GetModuleFileNameW( NULL, path, ARRAY_SIZE(path) )) return;
+    if (!(name = wcsrchr( path, '\\' ))) name = path; else name++;
+    if ((dot = wcsrchr( name, '.' )) && dot != name) *dot = 0;
+    if (!*name) return;
+
+    swprintf( title, ARRAY_SIZE(title), saving ? L"Save file (%s)" : L"Select file (%s)", name );
+    copy_wchar_to_utf8( buf, len, title );
+}
+
+static UINT64 get_owner_x11_window( HWND hwnd )
+{
+#define COMDLG32_X11DRV_ESCAPE       6789
+#define COMDLG32_X11DRV_GET_DRAWABLE 1
+    struct
+    {
+        DWORD  code;
+        DWORD  pad;
+        UINT64 drawable;
+        RECT   dc_rect;
+    } escape = { COMDLG32_X11DRV_GET_DRAWABLE };
+    UINT64 ret = 0;
+    HDC hdc;
+
+    if (!hwnd) return 0;
+    if (!(hdc = GetDC( hwnd ))) return 0;
+    if (ExtEscape( hdc, COMDLG32_X11DRV_ESCAPE, sizeof(escape), (const char *)&escape,
+                   sizeof(escape), (char *)&escape ) > 0)
+        ret = escape.drawable;
+    ReleaseDC( hwnd, hdc );
+
+    TRACE("owner %p -> x11 drawable %#llx\n", hwnd, (unsigned long long)ret);
+    return ret;
+}

+     * is not cosmetic. The user can start a second Export while the first chooser
+     * is still open; the first is then orphaned behind the main window, and
+     * closing them out of order crashes the application with an
+     * AccessViolationException in a dialog callback still holding a released
+     * DataSource. */
+    if (hwndOwner && IsWindowEnabled(hwndOwner))
+    {
+        EnableWindow(hwndOwner, FALSE);
+        owner_disabled = TRUE;
+    }
 
     thread = CreateThread(NULL, 0, portal_call_thread, &thread_params, 0, NULL);
-    if (!thread) return STATUS_INTERNAL_ERROR;
+    if (!thread)
+    {
+        if (owner_disabled) EnableWindow(hwndOwner, TRUE);
+        return STATUS_INTERNAL_ERROR;

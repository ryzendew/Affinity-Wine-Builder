     while (MsgWaitForMultipleObjects(1, &thread, FALSE, INFINITE, QS_ALLINPUT) != WAIT_OBJECT_0)
     {
@@ -2628,6 +2651,10 @@ static NTSTATUS call_unix_portal_pumping(enum comdlg32_unix_funcs code, void *pa
         }
     }
     CloseHandle(thread);
+
+    /* Re-enable before returning, so the caller can legitimately show another
+     * dialog straight afterwards. */
+    if (owner_disabled) EnableWindow(hwndOwner, TRUE);
     return thread_params.status;

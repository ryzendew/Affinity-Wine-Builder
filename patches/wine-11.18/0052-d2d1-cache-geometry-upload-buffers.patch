+#define D2D_BUFFER_CACHE_SIZE 8
+#define D2D_BUFFER_CACHE_MAX_BYTES (4 * 1024 * 1024)
+
+/* Reuse per-frame geometry upload buffers instead of creating and
+ * destroying GPU buffers for every draw. Buffers are refilled with
+ * UpdateSubresource, which wined3d versions internally, so reuse is safe
+ * even if the GPU is still reading the previous contents. */
+static HRESULT d2d_device_context_get_buffer(struct d2d_device_context *context,
+        unsigned int bind_flags, size_t byte_width, const void *data, ID3D11Buffer **buffer)
+{
+    struct d2d_buffer_cache_entry *cache;
+    ID3D11DeviceContext *d3d_context;
+    D3D11_SUBRESOURCE_DATA subresource_data;
+    D3D11_BUFFER_DESC desc;
+    D3D11_BOX box;
+    unsigned int i;
+    HRESULT hr;
+
+    cache = bind_flags == D3D11_BIND_INDEX_BUFFER ? context->ib_cache : context->vb_cache;
+
+    if (byte_width && byte_width <= D2D_BUFFER_CACHE_MAX_BYTES)
+    {
+        if (context->cs)
+            EnterCriticalSection(context->cs);
+        for (i = 0; i < D2D_BUFFER_CACHE_SIZE; ++i)
+        {
+            if (cache[i].buffer && cache[i].size >= byte_width)
+            {
+                *buffer = cache[i].buffer;
+                cache[i].buffer = NULL;
+                cache[i].size = 0;
+                if (context->cs)
+                    LeaveCriticalSection(context->cs);
+                ID3D11Device1_GetImmediateContext(context->d3d_device, &d3d_context);
+                /* The cached buffer is allowed to be larger than byte_width.
+                 * A NULL box makes wined3d size the copy from the destination
+                 * subresource, which would read past the end of data, so bound
+                 * the update to the bytes we actually have. */
+                box.left = box.top = box.front = 0;
+                box.right = byte_width;
+                box.bottom = 1;
+                box.back = 1;
+                ID3D11DeviceContext_UpdateSubresource(d3d_context,
+                        (ID3D11Resource *)*buffer, 0, &box, data, 0, 0);
+                ID3D11DeviceContext_Release(d3d_context);
+                return S_OK;
+            }
+        }
+        if (context->cs)
+            LeaveCriticalSection(context->cs);
+    }
+
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.ByteWidth = byte_width;
+    desc.BindFlags = bind_flags;
+    desc.CPUAccessFlags = 0;
+    desc.MiscFlags = 0;
+    subresource_data.pSysMem = data;
+    subresource_data.SysMemPitch = 0;
+    subresource_data.SysMemSlicePitch = 0;
+
+    hr = ID3D11Device1_CreateBuffer(context->d3d_device, &desc, &subresource_data, buffer);
+    if (FAILED(hr))
+        WARN("Failed to create buffer, hr %#lx.\n", hr);
+    return hr;
+}
+
+static void d2d_device_context_put_buffer(struct d2d_device_context *context,
+        unsigned int bind_flags, ID3D11Buffer *buffer, size_t size)
+{
+    struct d2d_buffer_cache_entry *cache;
+    D3D11_BUFFER_DESC desc;
+    unsigned int i;
+
+    if (!buffer)
+        return;
+
+    if (!size || size > D2D_BUFFER_CACHE_MAX_BYTES)
+    {
+        ID3D11Buffer_Release(buffer);
+        return;
+    }
+
+    /* Record the buffer's real capacity, not the size of the data last
+     * written into it. Otherwise a large buffer reused for a small draw
+     * shrinks its recorded size and stops matching later large requests,
+     * which defeats the cache and brings the CreateBuffer churn back. */
+    ID3D11Buffer_GetDesc(buffer, &desc);
+    if (!desc.ByteWidth || desc.ByteWidth > D2D_BUFFER_CACHE_MAX_BYTES)
+    {
+        ID3D11Buffer_Release(buffer);
+        return;
+    }
+
+    cache = bind_flags == D3D11_BIND_INDEX_BUFFER ? context->ib_cache : context->vb_cache;
+
+    if (context->cs)
+        EnterCriticalSection(context->cs);
+    for (i = 0; i < D2D_BUFFER_CACHE_SIZE; ++i)
+    {
+        if (!cache[i].buffer)
+        {
+            cache[i].buffer = buffer;
+            cache[i].size = desc.ByteWidth;
+            buffer = NULL;
+            break;
+        }
+    }
+    if (context->cs)
+        LeaveCriticalSection(context->cs);
+
+    if (buffer)
+        ID3D11Buffer_Release(buffer);
+}

+/* GenericParam rows are sorted by owner first so the in-memory layout keeps
+ * the table ordered; the wire order (number, flags, owner, name) is handled
+ * by the serializer below. */
+struct genericparam_row
+{
+    UINT owner;
+    UINT number;
+    UINT flags;
+    UINT name;
+};
+
+static UINT add_genericparam_row( UINT owner, UINT number, UINT flags, UINT name )
+{
+    struct genericparam_row row = { owner, number, flags, name };
+    return add_row( TABLE_GENERICPARAM, (const BYTE *)&row, sizeof(row) );
+}
+
+static void serialize_genericparam_table( void )
+{
+    const struct genericparam_row *row = (const struct genericparam_row *)current_winmd->tables[TABLE_GENERICPARAM].ptr;
+    UINT i;
+
+    for (i = 0; i < current_winmd->tables[TABLE_GENERICPARAM].count; i++)
+    {
+        serialize_ushort( row->number );
+        serialize_ushort( row->flags );
+        /* Owner uses a single tag bit (0 for TypeDef); verified against
+         * Microsoft's own winmds and System.Reflection.Metadata. */
+        serialize_table_idx( row->owner, TABLE_TYPEDEF );
+        serialize_string_idx( row->name );
+        row++;
+    }
+}

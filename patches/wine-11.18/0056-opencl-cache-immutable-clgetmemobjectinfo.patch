 cl_int WINAPI clGetMemObjectInfo( cl_mem memobj, cl_mem_info param_name, size_t param_value_size, void* param_value, size_t* param_value_size_ret )
 {
     struct clGetMemObjectInfo_params params = { memobj, param_name, param_value_size, param_value, param_value_size_ret };
+    size_t cached_size;
+    int hit;
+
     TRACE( "(%p, %u, %Iu, %p, %p)\n", memobj, param_name, param_value_size, param_value, param_value_size_ret );
-    return OPENCL_CALL( clGetMemObjectInfo, &params );
+
+    /* CL_MEM_SIZE and CL_MEM_FLAGS are fixed for the lifetime of the object, but
+       Affinity polls them in tight loops: 13.6k calls, 36% of all OpenCL traffic
+       in one traced session, with up to 1.5k calls on a single handle in a
+       single second. Serve them from the cache. */
+    if (param_name == CL_MEM_SIZE || param_name == CL_MEM_FLAGS)
+    {
+        if ((hit = info_cache_find( memobj, param_name, OPENCL_CACHE_MEMOBJ,
+                param_value, param_value_size, &cached_size )) == OPENCL_CACHE_HIT)
+        {
+            TRACE( "returning cached mem info %#x\n", param_name );
+            if (param_value_size_ret) *param_value_size_ret = cached_size;
+            return CL_SUCCESS;
+        }
+        if (hit == OPENCL_CACHE_TOO_SMALL)
+            return CL_INVALID_VALUE;
+    }
+
+    {
+        size_t unix_size = 0;
+        cl_int ret;
+
+        /* Affinity passes NULL for the size out-parameter on the large majority
+           of calls, so capture it ourselves in order to cache the value. */
+        params.param_value_size_ret = param_value_size_ret ? param_value_size_ret : &unix_size;
+        ret = OPENCL_CALL( clGetMemObjectInfo, &params );
+
+        if (ret == CL_SUCCESS && param_value
+                && (param_name == CL_MEM_SIZE || param_name == CL_MEM_FLAGS))
+            info_cache_store( memobj, param_name, OPENCL_CACHE_MEMOBJ,
+                    param_value, param_value_size_ret ? *param_value_size_ret : unix_size );
+        return ret;
+    }
 }
 

+/* Drop every cached value for an object. Must be called before a handle can be
+   recycled by the driver, otherwise a new object allocated at the same address
+   would inherit the previous object's CL_MEM_SIZE / CL_MEM_FLAGS. */
+void info_cache_invalidate( void *object )
+{
+    struct info_cache_entry **pp = &info_cache_head, *entry;
+
+    if (!object) return;
+
+    AcquireSRWLockExclusive( &opencl_cache_lock );
+    while ((entry = *pp))
+    {
+        if (entry->object != object)
+        {
+            pp = &entry->next;
+            continue;
+        }
+        *pp = entry->next;
+        HeapFree( GetProcessHeap(), 0, entry );
+        info_cache_count--;
+    }
+    ReleaseSRWLockExclusive( &opencl_cache_lock );
+}

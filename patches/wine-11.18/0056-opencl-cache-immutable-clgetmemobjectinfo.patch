diff -urN a/dlls/opencl/opencl_private.h b/dlls/opencl/opencl_private.h
--- a/dlls/opencl/opencl_private.h
+++ b/dlls/opencl/opencl_private.h
@@ -32,6 +32,27 @@
 
 BOOL extension_is_supported( const char *name, size_t len );
 
+/* Cache of immutable OpenCL info values (device/platform/memory-object
+ * parameters that cannot change over the lifetime of the object). Used to
+ * avoid repeating PE->unix round trips for values the application hammers. */
+
+enum opencl_info_cache_kind
+{
+    OPENCL_CACHE_DEVICE   = 0,
+    OPENCL_CACHE_PLATFORM = 1,
+    OPENCL_CACHE_MEMOBJ   = 2,
+};
+
+#define OPENCL_CACHE_MISS        0
+#define OPENCL_CACHE_HIT         1
+#define OPENCL_CACHE_TOO_SMALL  -1
+
+int info_cache_find( void *object, unsigned int name, int kind,
+                     void *out, size_t out_size, size_t *out_stored );
+void info_cache_store( void *object, unsigned int name, int kind,
+                       const void *data, size_t size );
+void info_cache_invalidate( void *object );
+
 #define OPENCL_CALL( func, params ) WINE_UNIX_CALL( unix_ ## func, params )
 
 #endif

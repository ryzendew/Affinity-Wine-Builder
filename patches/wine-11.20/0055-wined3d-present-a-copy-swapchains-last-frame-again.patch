@@ -139,6 +139,9 @@ static void wined3d_swapchain_vk_destroy_vulkan_swapchain(struct wined3d_swapcha
 
 static void wined3d_swapchain_vk_destroy_object(void *object)
 {
+    struct wined3d_swapchain_vk *swapchain_vk = object;
+
+    wined3d_cs_cancel_nudge(&swapchain_vk->s);
     wined3d_swapchain_vk_destroy_vulkan_swapchain(object);
 }
 
@@ -1374,6 +1377,20 @@ static const struct wined3d_swapchain_ops swapchain_vk_ops =
     swapchain_frontbuffer_updated,
 };
 
+bool wined3d_swapchain_wants_nudge(const struct wined3d_swapchain *swapchain,
+        const RECT *src_rect, const RECT *dst_rect, unsigned int swap_interval)
+{
+    const struct wined3d_swapchain_desc *desc = &swapchain->state.desc;
+    RECT full_rect;
+
+    return swapchain->swapchain_ops == &swapchain_vk_ops
+            && wined3d_swapchain_vk((struct wined3d_swapchain *)swapchain)->vk_swapchain
+            && !swap_interval && desc->windowed && desc->backbuffer_count == 1
+            && (desc->swap_effect == WINED3D_SWAP_EFFECT_COPY || desc->swap_effect == WINED3D_SWAP_EFFECT_COPY_VSYNC)
+            && (!swapchain_present_is_partial_copy((struct wined3d_swapchain *)swapchain, dst_rect)
+            || swapchain_present_can_expand((struct wined3d_swapchain *)swapchain, src_rect, dst_rect, &full_rect));
+}

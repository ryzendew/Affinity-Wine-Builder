+/* A frame presented through a Vulkan swapchain to a Wine child window under
+ * Xwayland can stay unshown until the next present arrives. Applications
+ * that present only when something changes, like WPF, then always show the
+ * frame before the current one. If the back buffer has not been written
+ * since such a present, present it again, a little later and once more after
+ * that: with a COPY swap effect it still holds exactly that frame.
+ *
+ * The application thread changes and frees swapchain state, back buffers
+ * included, under the wined3d mutex and outside the command stream. So
+ * present only while holding the mutex, and only with nothing queued: any
+ * such change that is still pending sits in the queue. */
+static void wined3d_cs_nudge(struct wined3d_cs *cs)
+{
+    struct wined3d_swapchain *swapchain, *next;
+    ULONG64 due, now;
+
+    if (!wined3d_cs_get_nudge_due(cs, &due) || (now = GetTickCount64()) < due)
+        return;
+    if (!wined3d_mutex_try_lock())
+        return;
+
+    if (wined3d_cs_queue_is_empty(cs, &cs->queue[WINED3D_CS_QUEUE_DEFAULT])
+            && wined3d_cs_queue_is_empty(cs, &cs->queue[WINED3D_CS_QUEUE_MAP]))
+    {
+        LIST_FOR_EACH_ENTRY_SAFE(swapchain, next, &cs->nudge_list, struct wined3d_swapchain, nudge_entry)
+        {
+            if (swapchain->back_buffers[0] != swapchain->nudge_back_buffer
+                    || swapchain->back_buffers[0]->write_count != swapchain->nudge_write_count)
+            {
+                wined3d_cs_cancel_nudge(swapchain);
+                continue;
+            }
+            if (now < swapchain->nudge_due)
+                continue;
+            if (!IsWindowVisible(swapchain->win_handle))
+            {
+                wined3d_cs_cancel_nudge(swapchain);
+                continue;
+            }
+
+            TRACE("Re-presenting swapchain %p.\n", swapchain);
+            wined3d_cs_command_lock(cs);
+            swapchain->swapchain_ops->swapchain_present(swapchain, &swapchain->nudge_src_rect,
+                    &swapchain->nudge_dst_rect, swapchain->nudge_swap_interval, swapchain->nudge_flags);
+            wined3d_cs_command_unlock(cs);
+
+            if (++swapchain->nudge_stage == 1)
+                swapchain->nudge_due = now + 45;
+            else
+                wined3d_cs_cancel_nudge(swapchain);
+        }
+    }
+
+    wined3d_mutex_unlock();
+}
+
 static DWORD WINAPI wined3d_cs_run(void *ctx)
 {
     struct wined3d_cs_queue *queue;
@@ -3651,6 +3752,7 @@ static DWORD WINAPI wined3d_cs_run(void *ctx)
             queue = &cs->queue[WINED3D_CS_QUEUE_DEFAULT];
             if (wined3d_cs_queue_is_empty(cs, queue))
             {
+                wined3d_cs_nudge(cs);
                 YieldProcessor();
                 if (++spin_count >= WINED3D_CS_SPIN_COUNT)
                 {
@@ -3719,6 +3821,7 @@ struct wined3d_cs *wined3d_cs_create(struct wined3d_device *device,
     cs->c.ops = &wined3d_cs_st_ops;
     cs->c.device = device;
     cs->serialize_commands = TRACE_ON(d3d_sync) || wined3d_settings.cs_multithreaded & WINED3D_CSMT_SERIALIZE;
+    list_init(&cs->nudge_list);
 
     if (cs->serialize_commands)
         ERR_(d3d_sync)("Forcing serialization of all command streams.\n");

 static void wined3d_cs_wait_event(struct wined3d_cs *cs)
 {
     static const LARGE_INTEGER query_timeout = {.QuadPart = WINED3D_CS_COMMAND_WAIT_WITH_QUERIES_TIMEOUT * -10};
     const LARGE_INTEGER *timeout = NULL;
+    LARGE_INTEGER nudge_timeout;
+    ULONG64 due, now;
 
     if (!list_empty(&cs->query_poll_list))
         timeout = &query_timeout;
+    if (wined3d_cs_get_nudge_due(cs, &due))
+    {
+        now = GetTickCount64();
+        nudge_timeout.QuadPart = due > now ? (LONGLONG)(due - now) * -10000 : -10000;
+        if (!timeout || nudge_timeout.QuadPart > timeout->QuadPart)
+            timeout = &nudge_timeout;
+    }
 
     InterlockedExchange(&cs->waiting_for_event, TRUE);
 

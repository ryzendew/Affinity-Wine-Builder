+void wined3d_cs_cancel_nudge(struct wined3d_swapchain *swapchain)
+{
+    list_remove(&swapchain->nudge_entry);
+    list_init(&swapchain->nudge_entry);
+}
+
+static bool wined3d_cs_get_nudge_due(const struct wined3d_cs *cs, ULONG64 *due)
+{
+    const struct wined3d_swapchain *swapchain;
+
+    if (list_empty(&cs->nudge_list))
+        return false;
+    *due = ~(ULONG64)0;
+    LIST_FOR_EACH_ENTRY(swapchain, &cs->nudge_list, struct wined3d_swapchain, nudge_entry)
+        *due = min(*due, swapchain->nudge_due);
+    return true;
+}

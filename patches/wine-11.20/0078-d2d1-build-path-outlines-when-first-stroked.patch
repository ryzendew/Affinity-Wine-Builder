+/* Outlines are built when the geometry is first stroked. EndFigure() used to
+ * build each figure's outline at once, and most path geometries are only ever
+ * filled: Affinity rebuilds thousands of filled glyph and ruler paths a second.
+ * Close() reworks the figures for the fill (self-intersections, overlapping
+ * beziers), so it first keeps them as they were ended: on a close-cache hit by
+ * taking the arrays the cached result replaces, otherwise as copies. */
+static SRWLOCK d2d_outline_lock = SRWLOCK_INIT;
+
+static BOOL d2d_path_geometry_alloc_outline_figures(struct d2d_geometry *geometry)
+{
+    if (geometry->u.path.outline_built >= geometry->u.path.figure_count)
+        return TRUE;
+    if (!(geometry->u.path.outline_figures = calloc(geometry->u.path.figure_count,
+            sizeof(*geometry->u.path.outline_figures))))
+        return FALSE;
+    geometry->u.path.outline_figure_count = geometry->u.path.figure_count;
+    return TRUE;
+}
+
+static void d2d_path_geometry_keep_outline_figure(struct d2d_geometry *geometry, size_t i,
+        struct d2d_figure *figure)
+{
+    struct d2d_figure *kept = &geometry->u.path.outline_figures[i];
+
+    kept->vertices = figure->vertices;
+    kept->vertex_types = figure->vertex_types;
+    kept->vertex_count = figure->vertex_count;
+    kept->bezier_controls = figure->bezier_controls;
+    kept->bezier_control_count = figure->bezier_control_count;
+    kept->flags = figure->flags;
+}
+
+static BOOL d2d_path_geometry_copy_outline_figures(struct d2d_geometry *geometry)
+{
+    const struct d2d_figure *figure;
+    struct d2d_figure *kept;
+    size_t i;
+
+    for (i = geometry->u.path.outline_built; i < geometry->u.path.outline_figure_count; ++i)
+    {
+        figure = &geometry->u.path.figures[i];
+        kept = &geometry->u.path.outline_figures[i];
+        kept->flags = figure->flags;
+        if (!figure->vertex_count)
+            continue;
+        kept->vertices = d2d_memdup(figure->vertices, figure->vertex_count * sizeof(*figure->vertices));
+        kept->vertex_types = d2d_memdup(figure->vertex_types, figure->vertex_count * sizeof(*figure->vertex_types));
+        kept->bezier_controls = d2d_memdup(figure->bezier_controls,
+                figure->bezier_control_count * sizeof(*figure->bezier_controls));
+        if (!kept->vertices || !kept->vertex_types || (figure->bezier_control_count && !kept->bezier_controls))
+            return FALSE;
+        kept->vertex_count = figure->vertex_count;
+        kept->bezier_control_count = figure->bezier_control_count;
+    }
+    return TRUE;
+}
+
+static void d2d_path_geometry_build_outline(struct d2d_geometry *geometry)
+{
+    struct d2d_figure *figures = geometry->u.path.figures;
+    size_t i, end = geometry->u.path.figure_count;
+
+    if (geometry->u.path.outline_figures)
+    {
+        figures = geometry->u.path.outline_figures;
+        end = geometry->u.path.outline_figure_count;
+    }
+    else if (geometry->u.path.state == D2D_GEOMETRY_STATE_FIGURE && end)
+    {
+        --end;
+    }
+
+    for (i = geometry->u.path.outline_built; figures && i < end; ++i)
+    {
+        if (!d2d_geometry_add_figure_outline(geometry, &figures[i], (figures[i].flags & D2D_FIGURE_FLAG_CLOSED)
+                ? D2D1_FIGURE_END_CLOSED : D2D1_FIGURE_END_OPEN))
+        {
+            ERR("Failed to add figure outline.\n");
+            break;
+        }
+    }
+    if (end > geometry->u.path.outline_built)
+        geometry->u.path.outline_built = end;
+    d2d_path_geometry_free_outline_figures(geometry);
+}
+
+/* Builds the outline at once, from the figures as they are now; when the figures cannot be kept. */
+static void d2d_path_geometry_build_outline_now(struct d2d_geometry *geometry)
+{
+    d2d_path_geometry_free_outline_figures(geometry);
+    d2d_path_geometry_build_outline(geometry);
+    geometry->outline_pending = FALSE;
+}
+
+static void d2d_geometry_ensure_outline(struct d2d_geometry *geometry)
+{
+    if (!ReadAcquire(&geometry->outline_pending))
+        return;
+    AcquireSRWLockExclusive(&d2d_outline_lock);
+    if (geometry->outline_pending)
+    {
+        d2d_path_geometry_build_outline(geometry);
+        WriteRelease(&geometry->outline_pending, FALSE);
+    }
+    ReleaseSRWLockExclusive(&d2d_outline_lock);
+}

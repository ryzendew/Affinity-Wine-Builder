+
+/* The geometry whose outline a stroke of this one draws: transformed geometries and
+ * groups share their source's. Builds a path geometry's outline when first needed. */
+const struct d2d_geometry *d2d_geometry_get_outline(const struct d2d_geometry *geometry)
+{
+    for (;;)
+    {
+        const ID2D1GeometryVtbl *vtbl = geometry->ID2D1Geometry_iface.lpVtbl;
+
+        if (vtbl == (const ID2D1GeometryVtbl *)&d2d_transformed_geometry_vtbl)
+            geometry = unsafe_impl_from_ID2D1Geometry(geometry->u.transformed.src_geometry);
+        else if (vtbl == (const ID2D1GeometryVtbl *)&d2d_geometry_group_vtbl)
+            geometry = unsafe_impl_from_ID2D1Geometry((ID2D1Geometry *)geometry->u.group.path);
+        else
+            break;
+    }
+    if (geometry->ID2D1Geometry_iface.lpVtbl == (const ID2D1GeometryVtbl *)&d2d_path_geometry_vtbl)
+        d2d_geometry_ensure_outline((struct d2d_geometry *)geometry);
+    return geometry;
+}

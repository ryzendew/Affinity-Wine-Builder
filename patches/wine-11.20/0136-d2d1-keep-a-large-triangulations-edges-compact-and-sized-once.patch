From b0dbe414ea9f15dad6e2154c847acd50a8cc479e Mon Sep 17 00:00:00 2001
From: jfacemyer <1776340+jfacemyer@users.noreply.github.com>
Date: Tue, 3 Nov 2026 00:28:29 -0500
Subject: [PATCH 4/8] d2d1: Keep a large triangulation's edges compact and
 sized once.

A Close() triangulation edge took 88 bytes, mostly size_t indices; with
32-bit ones it takes 44, and the per-vertex edge lists entries half as
much. Both arrays are now sized from the vertex count before the
triangulation starts (a triangulation of n vertices has at most 3n edges;
the merges leave about 17 list entries per vertex) rather than grown and
copied at every doubling. The Delaunay triangulation of a 246,000-vertex
path went from 0.31 to 0.23 s. The triangulation is the same.
---
 dlls/d2d1/geometry.c | 22 ++++++++++++++--------
 1 file changed, 14 insertions(+), 8 deletions(-)

diff --git a/dlls/d2d1/geometry.c b/dlls/d2d1/geometry.c
index 1524669..7d64f19 100644
--- a/dlls/d2d1/geometry.c
+++ b/dlls/d2d1/geometry.c
@@ -239,14 +239,14 @@ static bool d2d_figure_add_arc_segment(struct d2d_geometry *geometry, const D2D1
 
 struct d2d_cdt_edge_ref
 {
-    size_t idx;
-    enum d2d_cdt_edge_next r;
+    UINT32 idx;
+    UINT32 r; /* enum d2d_cdt_edge_next */
 };
 
 struct d2d_cdt_edge
 {
     struct d2d_cdt_edge_ref next[4];
-    size_t vertex[2];
+    UINT32 vertex[2];
     unsigned int flags;
 };
 
@@ -272,12 +272,12 @@ struct d2d_probe_edges
  * now is. */
 struct d2d_cdt_vertex_edges
 {
-    size_t *head;
+    UINT32 *head;
     size_t vertex_count;
     struct
     {
-        size_t edge;
-        size_t next;
+        UINT32 edge;
+        UINT32 next;
     } *nodes;
     size_t nodes_size;
     size_t node_count;
@@ -1884,7 +1884,7 @@ static void DECLSPEC_NOINLINE d2d_cdt_note_vertex_edge(const struct d2d_cdt *cdt
 
     if (ve->failed)
         return;
-    if (vertex >= ve->vertex_count || !d2d_array_reserve((void **)&ve->nodes,
+    if (vertex >= ve->vertex_count || ve->node_count >= ~0u || !d2d_array_reserve((void **)&ve->nodes,
             &ve->nodes_size, ve->node_count + 1, sizeof(*ve->nodes)))
     {
         ve->failed = TRUE;
@@ -3192,7 +3192,7 @@ static BOOL d2d_cdt_insert_segments(struct d2d_cdt *cdt, struct d2d_geometry *ge
             const struct d2d_cdt_vertex_edges *ve = cdt->vertex_edges;
             size_t n, best = ~(size_t)0;
 
-            for (n = ve->head[start_vertex]; n != ~(size_t)0; n = ve->nodes[n].next)
+            for (n = ve->head[start_vertex]; n != ~0u; n = ve->nodes[n].next)
             {
                 k = ve->nodes[n].edge;
                 if (k >= best || (cdt->edges[k].flags & D2D_CDT_EDGE_FLAG_FREED))
@@ -3902,6 +3902,9 @@ static HRESULT d2d_path_geometry_triangulate(struct d2d_geometry *geometry)
 
     cdt.free_edge = ~0u;
     cdt.vertices = vertices;
+    /* A triangulation of n vertices has at most 3n edges. Growing the array
+     * as the merges add them copied it at every doubling. */
+    d2d_array_reserve((void **)&cdt.edges, &cdt.edges_size, 3 * vertex_count + 3, sizeof(*cdt.edges));
 
     if (vertex_count >= D2D_BOX_GRID_MIN_COUNT
             && (vertex_edges.head = malloc(vertex_count * sizeof(*vertex_edges.head))))
@@ -3909,6 +3912,9 @@ static HRESULT d2d_path_geometry_triangulate(struct d2d_geometry *geometry)
         memset(vertex_edges.head, 0xff, vertex_count * sizeof(*vertex_edges.head));
         vertex_edges.vertex_count = vertex_count;
         cdt.vertex_edges = &vertex_edges;
+        /* Entries are never removed; the merges leave about 17 per vertex. */
+        d2d_array_reserve((void **)&vertex_edges.nodes, &vertex_edges.nodes_size,
+                18 * vertex_count, sizeof(*vertex_edges.nodes));
     }
 
 #ifdef __i386__
-- 
2.55.0


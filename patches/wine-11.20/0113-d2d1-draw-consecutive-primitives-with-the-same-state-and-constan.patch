 /* Draw primitives from data in memory: indices (16-bit, may be NULL for a
  * non-indexed draw of "count" vertices) and vertices. */
+static BOOL d2d_draw_batching(void)
+{
+    static int enabled = -1;
+    char buf[8];
+
+    if (enabled < 0)
+        enabled = !(GetEnvironmentVariableA("WINE_D2D_NO_DRAW_BATCHING", buf, sizeof(buf)) && atoi(buf));
+    return enabled;
+}
+
+/* Draw the primitives collected in the batch, with the constants and the state they
+ * were collected with. */
+void d2d_device_context_flush_draws(struct d2d_device_context *render_target)
+{
+    struct d2d_draw_batch *batch = &render_target->draw_batch;
+    unsigned int ib_offset, vb_offset, vs_cb_offset, ps_cb_offset;
+    BOOL vs_cb_pending;
+    HRESULT hr;
+
+    if (!batch->active || batch->flushing)
+        return;
+    batch->flushing = TRUE;
+
+    /* The next primitive may already have new constants waiting; draw with ours. */
+    vs_cb_offset = render_target->vs_cb_offset;
+    ps_cb_offset = render_target->ps_cb_offset;
+    vs_cb_pending = render_target->vs_cb_pending;
+    render_target->vs_cb_offset = batch->vs_cb_offset;
+    render_target->ps_cb_offset = batch->ps_cb_offset;
+    render_target->vs_cb_pending = FALSE;
+
+    if (FAILED(hr = d2d_upload_ring_write(render_target, batch->indices, batch->index_count * sizeof(WORD),
+            batch->vertices, batch->vertex_count * batch->vb_stride, batch->vb_stride, &ib_offset, &vb_offset)))
+        WARN("Failed to upload geometry, hr %#lx.\n", hr);
+    else
+        d2d_device_context_draw(render_target, batch->shape_type, render_target->upload_ring.buffer, ib_offset,
+                batch->index_count, render_target->upload_ring.buffer, vb_offset, batch->vb_stride, batch->brush, NULL);
+
+    render_target->vs_cb_offset = vs_cb_offset;
+    render_target->ps_cb_offset = ps_cb_offset;
+    render_target->vs_cb_pending = vs_cb_pending;
+
+    ID2D1Brush_Release(&batch->brush->ID2D1Brush_iface);
+    batch->brush = NULL;
+    batch->active = FALSE;
+    batch->flushing = FALSE;
+}
+
+/* Add a primitive to the batch if it can be drawn together with the ones already in
+ * it: the same shape, a solid brush (no textures to bind), and the same constants,
+ * i.e. the same offsets in the constant ring, which are only reused while the
+ * constants are unchanged. Everything that changes other state, or uses the target,
+ * draws the batch first: a constant ring map (which also covers a ring discard), any
+ * other draw, a clip change, and d2d_device_context_end_batch(), which runs at
+ * EndDraw, Flush, SetTarget, and before another context draws on the device.
+ *
+ * Affinity draws about 540 primitives a frame while a selection is dragged, half of
+ * them with the same state and constants as the one before. */
+static BOOL d2d_device_context_batch_draw(struct d2d_device_context *render_target, enum d2d_shape_type shape_type,
+        const WORD *indices, unsigned int index_size, unsigned int count, const void *vertices,
+        unsigned int vertex_size, unsigned int vb_stride, struct d2d_brush *brush, struct d2d_brush *opacity_brush)
+{
+    struct d2d_draw_batch *batch = &render_target->draw_batch;
+    unsigned int vertex_count, i;
+
+    if (!d2d_draw_batching() || !indices || !brush || opacity_brush || brush->type != D2D_BRUSH_TYPE_SOLID
+            || render_target->vs_cb_pending || !vb_stride || vertex_size % vb_stride
+            || index_size != count * sizeof(WORD))
+        return FALSE;
+    if ((vertex_count = vertex_size / vb_stride) > 0x10000)
+        return FALSE;
+
+    if (batch->active && (batch->shape_type != shape_type || batch->brush != brush
+            || batch->vb_stride != vb_stride || batch->vs_cb_offset != render_target->vs_cb_offset
+            || batch->ps_cb_offset != render_target->ps_cb_offset
+            || batch->vertex_count + vertex_count > 0x10000))
+        d2d_device_context_flush_draws(render_target);
+
+    if (!d2d_array_reserve((void **)&batch->indices, &batch->indices_size,
+            (batch->active ? batch->index_count : 0) + count, sizeof(*batch->indices))
+            || !d2d_array_reserve((void **)&batch->vertices, &batch->vertices_size,
+            ((batch->active ? batch->vertex_count : 0) + vertex_count) * vb_stride, 1))
+    {
+        d2d_device_context_flush_draws(render_target);
+        return FALSE;
+    }
+
+    if (!batch->active)
+    {
+        batch->active = TRUE;
+        batch->shape_type = shape_type;
+        batch->brush = brush;
+        ID2D1Brush_AddRef(&brush->ID2D1Brush_iface);
+        batch->vb_stride = vb_stride;
+        batch->vs_cb_offset = render_target->vs_cb_offset;
+        batch->ps_cb_offset = render_target->ps_cb_offset;
+        batch->index_count = 0;
+        batch->vertex_count = 0;
+    }
+
+    for (i = 0; i < count; ++i)
+        batch->indices[batch->index_count + i] = indices[i] + batch->vertex_count;
+    memcpy(batch->vertices + batch->vertex_count * vb_stride, vertices, vertex_size);
+    batch->index_count += count;
+    batch->vertex_count += vertex_count;
+    return TRUE;
+}
+
 static void d2d_device_context_draw_data(struct d2d_device_context *render_target, enum d2d_shape_type shape_type,
         const void *indices, unsigned int index_size, unsigned int count, const void *vertices,
         unsigned int vertex_size, unsigned int vb_stride, struct d2d_brush *brush, struct d2d_brush *opacity_brush)
@@ -468,6 +581,15 @@ static void d2d_device_context_draw_data(struct d2d_device_context *render_targe
     if (render_target->cs)
         EnterCriticalSection(render_target->cs);
 
+    if (d2d_device_context_batch_draw(render_target, shape_type, indices, index_size, count,

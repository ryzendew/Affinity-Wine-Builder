+    memmove(&list[pos + 2], &list[pos + 1], (*count - pos - 1) * sizeof(*list));
+    ++*count;
+    list[pos + 1].idx.figure_idx = idx.figure_idx;
+    list[pos + 1].idx.vertex_idx = idx.vertex_idx + 1;
+    list[pos + 1].idx.control_idx = idx.control_idx + 1;
+    for (i = pos + 2; i < *count && list[i].idx.figure_idx == idx.figure_idx; ++i)
+    {

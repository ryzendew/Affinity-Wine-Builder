+/* Intersect the geometry's segments with themselves. Every segment is tested
+ * against each segment before it whose box is not apart from its own; a grid
+ * finds those, in the same order an exhaustive walk visits them. */
+static BOOL d2d_geometry_intersect_self(struct d2d_geometry *geometry)
+{
+    struct d2d_geometry_intersections intersections = {0};
+    const struct d2d_figure *figure_p, *figure_q;
+    struct d2d_segment_idx *segs = NULL, idx_p, idx_q;
+    size_t seg_count, i, k, n, *candidates = NULL;
+    enum d2d_vertex_type type_p, type_q;
+    struct d2d_box_grid grid = {0};
+    D2D_RECT_F *boxes = NULL;
+    BOOL ret = FALSE;
+    float margin;
+
+    if (!geometry->u.path.figure_count)
+        return TRUE;
+
+    /* The figures don't change until the intersections are applied, after
+     * the loop, so each segment's box is computed once. */
+    for (i = 0, seg_count = 0; i < geometry->u.path.figure_count; ++i)
+        seg_count += geometry->u.path.figures[i].vertex_count;
+    if (seg_count < D2D_BOX_GRID_MIN_COUNT)
+        return d2d_geometry_intersect_self_exhaustive(geometry);
+    if (!(segs = malloc(seg_count * sizeof(*segs)))
+            || !(boxes = malloc(seg_count * sizeof(*boxes)))
+            || !(candidates = malloc(seg_count * sizeof(*candidates))))
+        goto done;
+    seg_count = 0;
+    for (idx_p.figure_idx = 0; idx_p.figure_idx < geometry->u.path.figure_count; ++idx_p.figure_idx)
+    {
+        figure_p = &geometry->u.path.figures[idx_p.figure_idx];
+        idx_p.control_idx = 0;
+        for (idx_p.vertex_idx = 0; idx_p.vertex_idx < figure_p->vertex_count; ++idx_p.vertex_idx)
+        {
+            if ((type_p = figure_p->vertex_types[idx_p.vertex_idx]) == D2D_VERTEX_TYPE_END)
+                continue;
+            segs[seg_count] = idx_p;
+            d2d_geometry_get_segment_box(geometry, &idx_p, d2d_vertex_type_is_bezier(type_p), &boxes[seg_count]);
+            ++seg_count;
+            if (d2d_vertex_type_is_bezier(type_p))
+                ++idx_p.control_idx;
+        }
+    }
+    margin = d2d_geometry_get_box_margin(geometry);
+    if (!d2d_box_grid_init(&grid, boxes, seg_count))
+        goto done;
+
+    for (k = 0; k < seg_count; ++k)
+    {
+        idx_p = segs[k];
+        figure_p = &geometry->u.path.figures[idx_p.figure_idx];
+        type_p = figure_p->vertex_types[idx_p.vertex_idx];
+
+        n = d2d_box_grid_query(&grid, &boxes[k], margin, k, candidates);
+        for (i = 0; i < n; ++i)
+        {
+            size_t q = candidates[i];
+
+            idx_q = segs[q];
+            figure_q = &geometry->u.path.figures[idx_q.figure_idx];
+            if (idx_q.figure_idx != idx_p.figure_idx
+                    && !d2d_rect_check_overlap(&figure_p->bounds, &figure_q->bounds))
+                continue;
+            if (d2d_rect_apart(&boxes[k], &boxes[q], margin))
+                continue;
+
+            type_q = figure_q->vertex_types[idx_q.vertex_idx];
+            if (d2d_vertex_type_is_bezier(type_q))
+            {
+                if (d2d_vertex_type_is_bezier(type_p))
+                {
+                    if (!d2d_geometry_intersect_bezier_bezier(geometry, &intersections,
+                            &idx_p, 0.0f, 1.0f, &idx_q, 0.0f, 1.0f))
+                        goto done;
+                }
+                else
+                {
+                    if (!d2d_geometry_intersect_bezier_line(geometry, &intersections, &idx_q, &idx_p))
+                        goto done;
+                }
+            }
+            else
+            {
+                if (d2d_vertex_type_is_bezier(type_p))
+                {

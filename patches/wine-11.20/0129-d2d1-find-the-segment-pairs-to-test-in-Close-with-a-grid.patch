+/* Finds, for one box, the boxes that d2d_rect_apart() does not rule out,
+ * without testing every pair. Each box is binned into the cells of a uniform
+ * grid that it covers; a query visits only the cells covered by its own box
+ * grown by twice the margin, which covers every box within the margin despite
+ * rounding. Boxes with non-finite coordinates, or covering many cells, are
+ * returned by every query. The caller still applies d2d_rect_apart(), so the
+ * pairs it goes on to test are exactly those an exhaustive walk would. */
+struct d2d_box_grid
+{
+    const D2D_RECT_F *boxes;
+    size_t count;
+    float x0, y0, sx, sy;
+    unsigned int w, h;
+    size_t *cell_start;
+    size_t *cell_items;
+    size_t *anywhere;
+    size_t anywhere_count;
+    size_t *stamp;
+    size_t query_id;
+    BOOL linear;
+};
+
+#define D2D_BOX_GRID_MAX_CELLS_PER_BOX 64
+/* Below this many boxes a query simply returns every box before the limit:
+ * setting up the grid costs more than the pair tests it saves. */
+#define D2D_BOX_GRID_MIN_COUNT 256
+
+static BOOL d2d_box_is_finite(const D2D_RECT_F *b)
+{
+    return isfinite(b->left) && isfinite(b->top) && isfinite(b->right) && isfinite(b->bottom);
+}
+
+static unsigned int d2d_box_grid_cell(float v, float origin, float scale, unsigned int n)
+{
+    float f = (v - origin) * scale;
+
+    if (!(f > 0.0f))
+        return 0;
+    if (f >= (float)n)
+        return n - 1;
+    return min((unsigned int)f, n - 1);
+}
+
+static void d2d_box_grid_cells(const struct d2d_box_grid *grid, const D2D_RECT_F *b, float grow,
+        unsigned int *x0, unsigned int *y0, unsigned int *x1, unsigned int *y1)
+{
+    *x0 = d2d_box_grid_cell(b->left - grow, grid->x0, grid->sx, grid->w);
+    *x1 = d2d_box_grid_cell(b->right + grow, grid->x0, grid->sx, grid->w);
+    *y0 = d2d_box_grid_cell(b->top - grow, grid->y0, grid->sy, grid->h);
+    *y1 = d2d_box_grid_cell(b->bottom + grow, grid->y0, grid->sy, grid->h);
+}
+
+static void d2d_box_grid_cleanup(struct d2d_box_grid *grid)
+{
+    free(grid->cell_start);
+    free(grid->cell_items);
+    free(grid->anywhere);
+    free(grid->stamp);
+    memset(grid, 0, sizeof(*grid));
+}
+
+static BOOL d2d_box_grid_init(struct d2d_box_grid *grid, const D2D_RECT_F *boxes, size_t count)
+{
+    float min_x = FLT_MAX, min_y = FLT_MAX, max_x = -FLT_MAX, max_y = -FLT_MAX;
+    unsigned int x0, y0, x1, y1, x, y;
+    size_t i, cells, total, *cursor;
+    BOOL *far = NULL;
+
+    memset(grid, 0, sizeof(*grid));
+    grid->boxes = boxes;
+    grid->count = count;
+    if (count < D2D_BOX_GRID_MIN_COUNT)
+    {
+        grid->linear = TRUE;
+        return TRUE;
+    }
+
+    for (i = 0; i < count; ++i)
+    {
+        if (!d2d_box_is_finite(&boxes[i]))
+            continue;
+        min_x = min(min_x, boxes[i].left);
+        min_y = min(min_y, boxes[i].top);
+        max_x = max(max_x, boxes[i].right);
+        max_y = max(max_y, boxes[i].bottom);
+    }
+
+    grid->w = grid->h = max(1, min(1024, (unsigned int)sqrt(count / 2.0)));
+    grid->x0 = min_x;
+    grid->y0 = min_y;
+    grid->sx = max_x > min_x ? grid->w / (max_x - min_x) : 0.0f;
+    grid->sy = max_y > min_y ? grid->h / (max_y - min_y) : 0.0f;
+    if (!isfinite(grid->sx))
+        grid->sx = 0.0f;
+    if (!isfinite(grid->sy))
+        grid->sy = 0.0f;
+    cells = (size_t)grid->w * grid->h;
+
+    if (!(grid->cell_start = calloc(cells + 1, sizeof(*grid->cell_start)))
+            || !(grid->stamp = calloc(max(count, 1), sizeof(*grid->stamp)))
+            || !(far = calloc(max(count, 1), sizeof(*far))))
+    {
+        d2d_box_grid_cleanup(grid);
+        return FALSE;
+    }
+
+    for (i = 0, total = 0; i < count; ++i)
+    {
+        if (!d2d_box_is_finite(&boxes[i]))
+        {
+            far[i] = TRUE;
+            ++grid->anywhere_count;
+            continue;
+        }
+        d2d_box_grid_cells(grid, &boxes[i], 0.0f, &x0, &y0, &x1, &y1);
+        if ((size_t)(x1 - x0 + 1) * (y1 - y0 + 1) > D2D_BOX_GRID_MAX_CELLS_PER_BOX)
+        {
+            far[i] = TRUE;
+            ++grid->anywhere_count;
+            continue;
+        }
+        for (y = y0; y <= y1; ++y)
+        {
+            for (x = x0; x <= x1; ++x)
+                ++grid->cell_start[y * grid->w + x + 1];
+        }
+        total += (size_t)(x1 - x0 + 1) * (y1 - y0 + 1);
+    }
+    for (i = 0; i < cells; ++i)
+        grid->cell_start[i + 1] += grid->cell_start[i];
+
+    if (!(grid->cell_items = malloc(max(total, 1) * sizeof(*grid->cell_items)))
+            || !(grid->anywhere = malloc(max(grid->anywhere_count, 1) * sizeof(*grid->anywhere))))
+    {
+        free(far);
+        d2d_box_grid_cleanup(grid);
+        return FALSE;
+    }
+
+    if (!(cursor = calloc(cells, sizeof(*cursor))))
+    {
+        free(far);
+        d2d_box_grid_cleanup(grid);
+        return FALSE;
+    }
+
+    /* Each cell lists its boxes in ascending order. */
+    grid->anywhere_count = 0;
+    for (i = 0; i < count; ++i)
+    {
+        if (far[i])
+        {
+            grid->anywhere[grid->anywhere_count++] = i;
+            continue;
+        }
+        d2d_box_grid_cells(grid, &boxes[i], 0.0f, &x0, &y0, &x1, &y1);
+        for (y = y0; y <= y1; ++y)
+        {
+            for (x = x0; x <= x1; ++x)
+            {
+                size_t cell = y * grid->w + x;
+                grid->cell_items[grid->cell_start[cell] + cursor[cell]++] = i;
+            }
+        }
+    }
+    free(cursor);
+    free(far);
+    return TRUE;
+}
+
+static int __cdecl d2d_size_t_compare(const void *a, const void *b)
+{
+    size_t x = *(const size_t *)a, y = *(const size_t *)b;
+
+    return x < y ? -1 : x > y;
+}
+
+/* Writes to "out" the boxes before "limit" that d2d_rect_apart() might not
+ * rule out against "box", in ascending order, and returns their count. "out"
+ * must hold "limit" entries. */
+static size_t d2d_box_grid_query(struct d2d_box_grid *grid, const D2D_RECT_F *box, float margin,
+        size_t limit, size_t *out)
+{
+    unsigned int x0, y0, x1, y1, x, y;
+    size_t i, j, n = 0, id;
+
+    if (grid->linear || !d2d_box_is_finite(box))
+    {
+        for (i = 0; i < limit; ++i)
+            out[i] = i;
+        return limit;
+    }
+
+    id = ++grid->query_id;
+    d2d_box_grid_cells(grid, box, 2.0f * margin, &x0, &y0, &x1, &y1);
+    for (y = y0; y <= y1; ++y)
+    {
+        for (x = x0; x <= x1; ++x)
+        {
+            size_t cell = y * grid->w + x;
+
+            for (j = grid->cell_start[cell]; j < grid->cell_start[cell + 1]; ++j)
+            {
+                i = grid->cell_items[j];
+                if (i >= limit || grid->stamp[i] == id)
+                    continue;
+                grid->stamp[i] = id;
+                out[n++] = i;
+            }
+        }
+    }
+    for (j = 0; j < grid->anywhere_count; ++j)
+    {
+        i = grid->anywhere[j];
+        if (i >= limit || grid->stamp[i] == id)
+            continue;
+        grid->stamp[i] = id;
+        out[n++] = i;
+    }
+    /* Usually a few dozen entries: insertion sort beats qsort there. */
+    if (n > 32)
+        qsort(out, n, sizeof(*out), d2d_size_t_compare);
+    else for (i = 1; i < n; ++i)
+    {
+        size_t v = out[i];
+
+        for (j = i; j && out[j - 1] > v; --j)
+            out[j] = out[j - 1];
+        out[j] = v;
+    }
+    return n;
+}
+

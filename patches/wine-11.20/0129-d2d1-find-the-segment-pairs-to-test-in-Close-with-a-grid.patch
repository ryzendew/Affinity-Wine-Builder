+ * and one control point. */
+static void d2d_bezier_list_split(struct d2d_geometry *geometry, struct d2d_bezier_ref *list, size_t *count, size_t pos)
+{
+    struct d2d_segment_idx idx = list[pos].idx;
+    size_t i;

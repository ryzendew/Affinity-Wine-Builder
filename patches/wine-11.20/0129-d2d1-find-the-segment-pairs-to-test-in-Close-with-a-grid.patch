+struct d2d_split_positions
+{
+    size_t pos[512];
+    size_t threshold[512];
+    size_t count;
+};
+
+static void d2d_split_positions_add(struct d2d_split_positions *s, size_t x)
+{
+    size_t j, k;
+
+    for (j = 0; j < s->count && s->pos[j] < x; ++j);
+    for (k = j; k < s->count; ++k)
+        ++s->pos[k];
+    memmove(&s->pos[j + 1], &s->pos[j], (s->count - j) * sizeof(*s->pos));
+    s->pos[j] = x;
+    ++s->count;
+    /* An entry at position o before any split now comes after inserted
+     * bezier k exactly when o >= pos[k] - k. */
+    for (k = 0; k < s->count; ++k)
+        s->threshold[k] = s->pos[k] - k;
+}
+
+static size_t d2d_split_positions_map(const struct d2d_split_positions *s, size_t o)
+{
+    size_t lo = 0, hi = s->count, mid;

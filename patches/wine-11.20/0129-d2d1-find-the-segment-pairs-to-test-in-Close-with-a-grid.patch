+static float d2d_probe_edge_right(const struct d2d_probe_edge *e)
+{
+    return max(e->p0.x, e->p1.x);
+}
+
+static int __cdecl d2d_probe_edge_compare(const void *a, const void *b)
+{
+    float x = d2d_probe_edge_right(a), y = d2d_probe_edge_right(b);
+
+    /* Rightmost first; NaNs first, so they are never skipped. */
+    if (isnan(x) || isnan(y))
+        return isnan(y) - isnan(x);
+    return x > y ? -1 : x < y;
+}

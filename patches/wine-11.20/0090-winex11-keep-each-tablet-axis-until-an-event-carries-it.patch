winex11: Keep each tablet axis until an event carries it.

An XInput event carries the axes from first_axis on, and evdev or
libinput send only the axes that changed, so a pen-down that changed
only the pressure reported the pressure as x and 0 as y. The first
packet of every stroke jumped to the screen's edge.
---
 dlls/winex11.drv/wintab.c | 67 +++++++++++++++++++++++++++++------------------
 1 file changed, 41 insertions(+), 26 deletions(-)

diff --git a/dlls/winex11.drv/wintab.c b/dlls/winex11.drv/wintab.c
index 87d5c1a..10df1fb 100644
--- a/dlls/winex11.drv/wintab.c
+++ b/dlls/winex11.drv/wintab.c
@@ -313,6 +313,22 @@ static WTPACKET      last_packet;
 #define             CURSORMAX 12
 static INT           button_state[CURSORMAX];
 
+/* An XInput event carries the axes from first_axis to first_axis + axes_count,
+ * and a driver that only reports what changed (evdev, libinput) sends just the
+ * pressure when only the pressure changed. Keep each cursor's last value of
+ * every axis and update it from the axes an event carries. */
+#define AXIS_COUNT 6
+static int axis_state[CURSORMAX][AXIS_COUNT];
+
+static const int *update_axes( int curnum, int first_axis, int axes_count, const int *axis_data )
+{
+    int i;
+
+    for (i = 0; i < axes_count && first_axis + i < AXIS_COUNT; i++)
+        axis_state[curnum][first_axis + i] = axis_data[i];
+    return axis_state[curnum];
+}
+
 static LOGCONTEXTW      gSysContext;
 static WTI_DEVICES_INFO gSysDevice;
 static WTI_CURSORS_INFO gSysCursor[CURSORMAX];
@@ -891,6 +907,7 @@ static BOOL motion_event( HWND hwnd, XEvent *event )
 {
     XDeviceMotionEvent *motion = (XDeviceMotionEvent *)event;
     LPWTI_CURSORS_INFO cursor;
+    const int *axes;
     int curnum = cursor_from_device(motion->deviceid, &cursor);
     if (curnum < 0)
         return FALSE;

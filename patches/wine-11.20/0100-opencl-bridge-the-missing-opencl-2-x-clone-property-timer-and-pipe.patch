+cl_kernel WINAPI clCloneKernel( cl_kernel source, cl_int *errcode_ret )
+{
+    cl_kernel __retval;
+    struct clCloneKernel_params params = { &__retval, source, errcode_ret };
+    TRACE( "(%p, %p)\n", source, errcode_ret );
+    OPENCL_CALL( clCloneKernel, &params );
+    return __retval;
+}
+
+cl_command_queue WINAPI clCreateCommandQueueWithProperties( cl_context context, cl_device_id device,
+        const intptr_t *properties, cl_int *errcode_ret )
+{
+    cl_command_queue __retval;
+    struct clCreateCommandQueueWithProperties_params params = { &__retval, context, device, properties, errcode_ret };
+    TRACE( "(%p, %p, %p, %p)\n", context, device, properties, errcode_ret );
+    OPENCL_CALL( clCreateCommandQueueWithProperties, &params );
+    return __retval;
+}
+
+cl_mem WINAPI clCreatePipe( cl_context context, cl_bitfield flags, uint32_t packet_size,
+        uint32_t max_packets, const intptr_t *properties, cl_int *errcode_ret )
+{
+    cl_mem __retval;
+    struct clCreatePipe_params params = { &__retval, context, flags, packet_size, max_packets, properties, errcode_ret };
+    TRACE( "(%p, %s, %u, %u, %p, %p)\n", context, wine_dbgstr_longlong(flags), packet_size, max_packets, properties, errcode_ret );
+    OPENCL_CALL( clCreatePipe, &params );
+    return __retval;
+}
+
+cl_program WINAPI clCreateProgramWithIL( cl_context context, const void *il, size_t length, cl_int *errcode_ret )
+{
+    cl_program __retval;
+    struct clCreateProgramWithIL_params params = { &__retval, context, il, length, errcode_ret };
+    TRACE( "(%p, %p, %Iu, %p)\n", context, il, length, errcode_ret );
+    OPENCL_CALL( clCreateProgramWithIL, &params );
+    return __retval;
+}
+
+cl_sampler WINAPI clCreateSamplerWithProperties( cl_context context, const intptr_t *properties, cl_int *errcode_ret )
+{
+    cl_sampler __retval;
+    struct clCreateSamplerWithProperties_params params = { &__retval, context, properties, errcode_ret };
+    TRACE( "(%p, %p, %p)\n", context, properties, errcode_ret );
+    OPENCL_CALL( clCreateSamplerWithProperties, &params );
+    return __retval;
+}
+
+cl_int WINAPI clGetDeviceAndHostTimer( cl_device_id device, cl_ulong *device_timestamp, cl_ulong *host_timestamp )
+{
+    struct clGetDeviceAndHostTimer_params params = { device, device_timestamp, host_timestamp };
+    TRACE( "(%p, %p, %p)\n", device, device_timestamp, host_timestamp );
+    return OPENCL_CALL( clGetDeviceAndHostTimer, &params );
+}
+
+cl_int WINAPI clGetHostTimer( cl_device_id device, cl_ulong *host_timestamp )
+{
+    struct clGetHostTimer_params params = { device, host_timestamp };
+    TRACE( "(%p, %p)\n", device, host_timestamp );
+    return OPENCL_CALL( clGetHostTimer, &params );
+}
+
+cl_int WINAPI clGetKernelSubGroupInfo( cl_kernel kernel, cl_device_id device, uint32_t param_name,
+        size_t input_value_size, const void *input_value,
+        size_t param_value_size, void *param_value, size_t *param_value_size_ret )
+{
+    struct clGetKernelSubGroupInfo_params params = { kernel, device, param_name, input_value_size, input_value,
+            param_value_size, param_value, param_value_size_ret };
+    TRACE( "(%p, %p, %u, %Iu, %p, %Iu, %p, %p)\n", kernel, device, param_name,
+            input_value_size, input_value, param_value_size, param_value, param_value_size_ret );
+    return OPENCL_CALL( clGetKernelSubGroupInfo, &params );
+}
+
+cl_int WINAPI clGetPipeInfo( cl_mem pipe, uint32_t param_name, size_t param_value_size,
+        void *param_value, size_t *param_value_size_ret )
+{
+    struct clGetPipeInfo_params params = { pipe, param_name, param_value_size, param_value, param_value_size_ret };
+    TRACE( "(%p, %u, %Iu, %p, %p)\n", pipe, param_name, param_value_size, param_value, param_value_size_ret );

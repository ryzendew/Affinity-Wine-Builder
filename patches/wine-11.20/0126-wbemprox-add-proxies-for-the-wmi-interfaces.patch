     return TRUE;
 }
 
+/* The class objects, contexts and qualifier sets here live in the process
+ * that uses them and are local interfaces, marshaled on Windows by fastprox's
+ * own IMarshal. Hand the same object to every apartment, as the free-threaded
+ * marshaler does, so that they can be passed through the WMI proxies. */
+HRESULT get_free_threaded_marshaler( IUnknown *outer, IUnknown **marshal, REFIID riid, void **obj )
+{
+    IUnknown *ftm;
+    HRESULT hr;
+
+    if (!*marshal)
+    {
+        if (FAILED(hr = CoCreateFreeThreadedMarshaler( outer, &ftm ))) return hr;
+        if (InterlockedCompareExchangePointer( (void **)marshal, ftm, NULL )) IUnknown_Release( ftm );
+    }
+    return IUnknown_QueryInterface( *marshal, riid, obj );
+}
+
+HRESULT WINAPI wbemprox_DllGetClassObject( REFCLSID rclsid, REFIID iid, LPVOID *ppv );
+
 HRESULT WINAPI DllGetClassObject( REFCLSID rclsid, REFIID iid, LPVOID *ppv )
 {
     IClassFactory *cf = NULL;
@@ -137,6 +156,7 @@ HRESULT WINAPI DllGetClassObject( REFCLSID rclsid, REFIID iid, LPVOID *ppv )
     {
        cf = &wbem_context_cf.IClassFactory_iface;
     }
-    if (!cf) return CLASS_E_CLASSNOTAVAILABLE;
+    /* the proxies and stubs of the WMI interfaces */
+    if (!cf) return wbemprox_DllGetClassObject( rclsid, iid, ppv );
     return IClassFactory_QueryInterface( cf, iid, ppv );
 }

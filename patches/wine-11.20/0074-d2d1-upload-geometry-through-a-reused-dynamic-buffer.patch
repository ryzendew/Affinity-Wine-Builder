+/* Copy a draw's indices and vertices into a dynamic buffer that is reused
+ * across draws. Creating a vertex and an index buffer with initial data for
+ * every primitive, and releasing them after the draw, cost two allocations
+ * and two uploads each time on both the application's thread and wined3d's;
+ * Affinity draws hundreds of primitives per frame. Each draw now appends both
+ * with one NO_OVERWRITE map, and the buffer is discarded (renamed) when it
+ * wraps. */
+static HRESULT d2d_upload_ring_write(struct d2d_device_context *context, const void *indices,
+        unsigned int index_size, const void *vertices, unsigned int vertex_size,
+        unsigned int *ib_offset, unsigned int *vb_offset)
+{
+    struct d2d_upload_ring *ring = &context->upload_ring;
+    D3D11_MAP map_type = D3D11_MAP_WRITE_NO_OVERWRITE;
+    unsigned int pos = (ring->pos + 15) & ~15u, size;
+    ID3D11DeviceContext1 *d3d_context;
+    D3D11_MAPPED_SUBRESOURCE map;
+    HRESULT hr;
+
+    size = ((index_size + 15) & ~15u) + vertex_size;
+    if (!ring->buffer || size > ring->size)
+    {
+        unsigned int new_size = max(ring->size * 2, 2 * 1024 * 1024);
+        D3D11_BUFFER_DESC desc;
+
+        while (new_size < size)
+            new_size *= 2;
+        desc.ByteWidth = new_size;
+        desc.Usage = D3D11_USAGE_DYNAMIC;
+        desc.BindFlags = D3D11_BIND_VERTEX_BUFFER | D3D11_BIND_INDEX_BUFFER;
+        desc.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+        desc.MiscFlags = 0;
+        desc.StructureByteStride = 0;
+        if (ring->buffer)
+            ID3D11Buffer_Release(ring->buffer);
+        ring->buffer = NULL;
+        ring->size = 0;
+        if (FAILED(hr = ID3D11Device1_CreateBuffer(context->d3d_device, &desc, NULL, &ring->buffer)))
+            return hr;
+        ring->size = new_size;
+        pos = 0;
+        map_type = D3D11_MAP_WRITE_DISCARD;
+    }
+    else if (pos + size > ring->size)
+    {
+        pos = 0;
+        map_type = D3D11_MAP_WRITE_DISCARD;
+    }
+
+    ID3D11Device1_GetImmediateContext1(context->d3d_device, &d3d_context);
+    if (SUCCEEDED(hr = ID3D11DeviceContext1_Map(d3d_context, (ID3D11Resource *)ring->buffer, 0, map_type, 0, &map)))
+    {
+        *ib_offset = pos;
+        if (index_size)
+            memcpy((BYTE *)map.pData + pos, indices, index_size);
+        *vb_offset = pos + ((index_size + 15) & ~15u);
+        memcpy((BYTE *)map.pData + *vb_offset, vertices, vertex_size);
+        ID3D11DeviceContext1_Unmap(d3d_context, (ID3D11Resource *)ring->buffer, 0);
+        ring->pos = pos + size;
+    }
+    ID3D11DeviceContext1_Release(d3d_context);
+    return hr;
+}
+
+/* Draw primitives from data in memory: indices (16-bit, may be NULL for a
+ * non-indexed draw of "count" vertices) and vertices. */
+static void d2d_device_context_draw_data(struct d2d_device_context *render_target, enum d2d_shape_type shape_type,
+        const void *indices, unsigned int index_size, unsigned int count, const void *vertices,
+        unsigned int vertex_size, unsigned int vb_stride, struct d2d_brush *brush, struct d2d_brush *opacity_brush)
+{
+    unsigned int ib_offset = 0, vb_offset = 0;
+    HRESULT hr;
+
+    if (render_target->cs)
+        EnterCriticalSection(render_target->cs);
+
+    if (FAILED(hr = d2d_upload_ring_write(render_target, indices, indices ? index_size : 0,
+            vertices, vertex_size, &ib_offset, &vb_offset)))
+        WARN("Failed to upload geometry, hr %#lx.\n", hr);
+    else
+        d2d_device_context_draw(render_target, shape_type, indices ? render_target->upload_ring.buffer : NULL,
+                ib_offset, count, render_target->upload_ring.buffer, vb_offset, vb_stride, brush, opacity_brush);
+
+    if (render_target->cs)
+        LeaveCriticalSection(render_target->cs);
+}

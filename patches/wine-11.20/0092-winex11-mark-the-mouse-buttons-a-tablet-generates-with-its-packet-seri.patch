winex11: Mark the mouse buttons a tablet generates with its packet serial.

A tablet driver sets the extra info of the mouse button messages it
generates to the serial number of the packet that pressed or released
the pen. Applications that read the stroke from wintab, Affinity among
them, match it with GetMessageExtraInfo to tell those messages from a
real mouse; without it they took the stroke as a mouse drag, with no
pressure.
---
 dlls/winex11.drv/mouse.c  | 15 ++++++++++++---
 dlls/winex11.drv/wintab.c | 18 ++++++++++++++++++
 dlls/winex11.drv/x11drv.h |  1 +
 3 files changed, 31 insertions(+), 3 deletions(-)

diff --git a/dlls/winex11.drv/mouse.c b/dlls/winex11.drv/mouse.c
index fa6ec1d..3a0c58e 100644
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -599,7 +599,8 @@ static POINT map_event_coords( HWND hwnd, Window window, Window event_root, POIN
     return dst;
 }
 
-static void send_mouse_input( HWND hwnd, POINT pos, UINT flags, UINT data, UINT time, const struct raw_mouse *raw )
+static void send_mouse_input_extra( HWND hwnd, POINT pos, UINT flags, UINT data, UINT time,
+                                    ULONG_PTR extra, const struct raw_mouse *raw )
 {
     INPUT input = { .type = INPUT_MOUSE };
 
@@ -610,10 +611,16 @@ static void send_mouse_input( HWND hwnd, POINT pos, UINT flags, UINT data, UINT
     input.mi.dwFlags = flags;
     input.mi.mouseData = data;
     input.mi.time = time;
+    input.mi.dwExtraInfo = extra;
 
     NtUserSendHardwareInput( hwnd, SEND_HWMSG_RAWINPUT, &input, (LPARAM)raw );
 }
 
+static void send_mouse_input( HWND hwnd, POINT pos, UINT flags, UINT data, UINT time, const struct raw_mouse *raw )
+{
+    send_mouse_input_extra( hwnd, pos, flags, data, time, 0, raw );
+}
+
 #ifdef SONAME_LIBXCURSOR
 
 /***********************************************************************
@@ -1583,7 +1590,8 @@ BOOL X11DRV_ButtonPress( HWND hwnd, XEvent *xev )
     }
 
     pt = map_event_coords( hwnd, event->window, event->root, root, pt );
-    send_mouse_input( hwnd, pt, MOUSEEVENTF_ABSOLUTE | flags, button_down_data[button], time, NULL );
+    send_mouse_input_extra( hwnd, pt, MOUSEEVENTF_ABSOLUTE | flags, button_down_data[button], time,
+                            tablet_button_extra_info( event->time ), NULL );
     return TRUE;
 }
 
@@ -1602,7 +1610,8 @@ BOOL X11DRV_ButtonRelease( HWND hwnd, XEvent *xev )
     TRACE( "hwnd %p/%lx button %u pos %s\n", hwnd, event->window, button, wine_dbgstr_point( &pt ) );
 
     pt = map_event_coords( hwnd, event->window, event->root, root, pt );
-    send_mouse_input( hwnd, pt, MOUSEEVENTF_ABSOLUTE | flags, button_up_data[button], time, NULL );
+    send_mouse_input_extra( hwnd, pt, MOUSEEVENTF_ABSOLUTE | flags, button_up_data[button], time,
+                            tablet_button_extra_info( event->time ), NULL );
     return TRUE;
 }
 
diff --git a/dlls/winex11.drv/wintab.c b/dlls/winex11.drv/wintab.c
index 1475ecc..958af1c 100644
--- a/dlls/winex11.drv/wintab.c
+++ b/dlls/winex11.drv/wintab.c
@@ -265,6 +265,21 @@ static int           key_release_type;
 static int           proximity_in_type;
 static int           proximity_out_type;
 
+/* A tablet driver marks the mouse buttons it generates with the serial number
+ * of the packet that pressed or released the pen, and applications that read
+ * the stroke from wintab match it with GetMessageExtraInfo to ignore those
+ * mouse messages. The core event for a pen button follows its XInput event
+ * with the same timestamp. */
+static BOOL      tablet_button_valid;
+static Time      tablet_button_time;
+static UINT      tablet_button_serial;
+
+ULONG_PTR tablet_button_extra_info( Time time )
+{
+    if (!tablet_button_valid || time != tablet_button_time) return 0;
+    return tablet_button_serial;
+}
+
 /* the dynamic event types are pointer input like core pointer events */
 BOOL is_tablet_pointer_event( int type )
 {
@@ -967,6 +982,9 @@ static BOOL button_event( HWND hwnd, XEvent *event )
     gMsgPacket.pkNormalPressure = axes[2];
     gMsgPacket.pkButtons = get_button_state(curnum);
     gMsgPacket.pkChanged = get_changed_state(&gMsgPacket);
+    tablet_button_time = button->time;
+    tablet_button_serial = gMsgPacket.pkSerialNumber;
+    tablet_button_valid = TRUE;
     send_message( hwndTabletDefault, WT_PACKET, gMsgPacket.pkSerialNumber, (LPARAM)hwnd );
     last_packet = gMsgPacket;
     return TRUE;
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index a4c66a3..ddc99d9 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -608,6 +608,7 @@ typedef BOOL (*x11drv_event_handler)( HWND hwnd, XEvent *event );
 
 extern void X11DRV_register_event_handler( int type, x11drv_event_handler handler, const char *name );
 extern BOOL is_tablet_pointer_event( int type );
+extern ULONG_PTR tablet_button_extra_info( Time time );
 
 extern BOOL X11DRV_ButtonPress( HWND hwnd, XEvent *event );
 extern BOOL X11DRV_ButtonRelease( HWND hwnd, XEvent *event );
